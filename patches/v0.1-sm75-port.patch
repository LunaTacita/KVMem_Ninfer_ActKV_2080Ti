diff --git a/src/core/wide_math.h b/src/core/wide_math.h
index 0881922..f411004 100644
--- a/src/core/wide_math.h
+++ b/src/core/wide_math.h
@@ -45,9 +45,13 @@ struct Uint128 {
     const std::uint64_t carry = result.low < left.low ? 1U : 0U;
 
     const std::uint64_t high_sum = left.high + right.high;
-    const bool high_wrapped      = high_sum < left.high;
-    result.high                  = high_sum + carry;
-    overflowed                   = high_wrapped || result.high < high_sum;
+    // Decide the carry out BEFORE writing result.high. This function is constexpr, and MSVC folds
+    // it for constant arguments; when the caller discards the value with (void) -- which the test
+    // suite does -- deriving the flag from result.high afterwards was observed to lose the flag
+    // write entirely at /O2 (ninfer_wide_math_test fails at /O2 and passes at /Od). Expressing it
+    // in terms of high_sum and carry keeps the flag independent of the store.
+    overflowed  = (high_sum < left.high) || (high_sum + carry < carry);
+    result.high = high_sum + carry;
     return result;
 }
 
