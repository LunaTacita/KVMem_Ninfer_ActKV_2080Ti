diff --git a/src/core/device.cu b/src/core/device.cu
index 1e3b9d2..0f724ce 100644
--- a/src/core/device.cu
+++ b/src/core/device.cu
@@ -63,6 +63,21 @@ void destroy_event(cudaEvent_t& event) noexcept {
 
 } // namespace
 
+namespace {
+// Last host-side execution marker. The model layer sets it immediately before it enqueues a batch;
+// it is a plain host pointer store, so it costs nothing measurable and changes no GPU ordering --
+// which matters enormously here, because every heavy diagnostic this port has tried (printf near
+// the report site, nsys, CUDA_LAUNCH_BLOCKING) masked the very defect it was chasing. A sticky CUDA
+// error is reported by whichever later call first synchronises, not by the kernel that raised it,
+// so this marker is the only record of what was actually in flight when it happened.
+const char* g_current_op    = "<none>";
+int         g_current_layer = -1;
+} // namespace
+
+void ninfer_set_current_op(const char* op, int layer) noexcept {
+    g_current_op    = op;
+    g_current_layer = layer;
+}
