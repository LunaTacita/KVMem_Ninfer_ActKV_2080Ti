+        const float a_r8_k  = __shfl_sync(0xffffffffU, fa1, base_a + k_idx);
+        const float a_r_k4  = __shfl_sync(0xffffffffU, fa2, base_a + k_idx);
+        const float a_r8_k4 = __shfl_sync(0xffffffffU, fa3, base_a + k_idx);
