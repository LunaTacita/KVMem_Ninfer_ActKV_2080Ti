+    const float fa1 = __uint_as_float(a1);
+    const float fa2 = __uint_as_float(a2);
+    const float fa3 = __uint_as_float(a3);
+    const float fb0 = __uint_as_float(b0);
+    const float fb1 = __uint_as_float(b1);
