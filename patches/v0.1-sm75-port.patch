+    asm volatile("mma.sync.aligned.m16n8k8.row.col.f16.f16.f16.f16 "
+                 "{%0,%1}, {%2,%3}, {%4}, {%0,%1};\n"
+                 : "+r"(d0), "+r"(d1)
+                 : "r"(a0), "r"(a1), "r"(b0));
