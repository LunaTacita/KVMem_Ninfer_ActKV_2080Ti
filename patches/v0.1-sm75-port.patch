     if (err == cudaSuccess) { return; }
     if (core::current_resident_memory()) {
@@ -70,8 +85,9 @@ void cuda_check(cudaError_t err, const char* expr, const char* file, int line) {
                                 ": CUDA_CHECK(" + expr + ") failed: " +
