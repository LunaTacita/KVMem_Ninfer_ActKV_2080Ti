+    bool conf_budget = false;
+    std::uint32_t conf_init_tokens = 0;  // start; 0 means B
+    std::uint32_t conf_upper_tokens = 0; // ceiling; 0 means B
+    // Sec. 6.1 aggregation: sliding-window size w, stride s between pooled minima, the bottom
+    // fraction b that forms R, and how many minima are required before a slope is trusted.
+    std::uint32_t conf_pool = 64;
+    std::uint32_t conf_stride = 8;
+    double conf_bottom_frac = 0.10;
+    std::uint32_t conf_min_pool = 8;
+    // Sec. 6.2 growth factor, applied at round boundaries only, plus the minimum number of rounds
+    // between two increases. The published rule is a per-round decision; wired per token it reaches
