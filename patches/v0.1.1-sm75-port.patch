+    return launch_grid<Bf16N256K5120MmaSchedule<4, 16>>;
+#else
     if (tokens <= 76) return launch_grid<Bf16N256K5120MmaSchedule<16, 8>>;
     return launch_grid<Bf16N256K5120MmaSchedule<8, 16>>;
+#endif
 }
 
