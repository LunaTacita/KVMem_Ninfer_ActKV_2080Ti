diff --git a/sm75_eval/deliver_kvmem.ps1 b/sm75_eval/deliver_kvmem.ps1
new file mode 100644
index 0000000..aa4faf6
--- /dev/null
+++ b/sm75_eval/deliver_kvmem.ps1
@@ -0,0 +1,156 @@
+﻿# ============================================================================
+# sm75 / KVMem 0.18 stack - P10 delivery refresh into E:\AI\KVMem_Ninfer_Speed.
+#
+# WHAT IT DOES
+#   Copies the four product executables and their staged runtime DLLs, the model
+#   artifact and the start script, creates logs/ and Cache/, and writes a README
+#   that states what was measured and what is still open. Every file is copied
+#   one at a time and verified by SHA256 (trap #33: a piped bulk copy aborts the
+#   whole set when one file is busy, which looks like a failed build).
+#
+# WHY THE HASHES ARE PRINTED
+#   Trap N55: the engine's own "build <id>" line is a compile-time stamp, so the
+#   only reliable identity of what was delivered is the executable hash.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK: traps #20/#81).
+# ============================================================================
+param(
+    [string]$BuildDir  = 'E:\AI\ninfer-fusion\kvmem_build',
+    [string]$Dest      = 'E:\AI\KVMem_Ninfer_Speed',
+    [string]$Model     = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [string]$StartScript = 'E:\AI\Trae_Project\SOLO_记忆系统\项目档案\项目_小显存本地部署方案_20260924\产出成果\脚本_启动_KVMem_Bonsai27B.ps1'
+)
+
+$ErrorActionPreference = 'Stop'
+$apps = Join-Path $BuildDir 'apps'
+foreach ($p in @($apps, $Model, $StartScript)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+$binDir   = Join-Path $Dest 'bin'
+$modelDir = Join-Path $Dest 'model'
+$startDir = Join-Path $Dest 'Start'
+foreach ($d in @($Dest, $binDir, $modelDir, $startDir, (Join-Path $Dest 'logs'), (Join-Path $Dest 'Cache'))) {
+    if (-not (Test-Path -LiteralPath $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null }
+}
+
+function Copy-Verified {
+    param([string]$Source, [string]$TargetDir)
+    $name = Split-Path -Leaf $Source
+    $target = Join-Path $TargetDir $name
+    try {
+        Copy-Item -LiteralPath $Source -Destination $target -Force
+    } catch {
+        Write-Output ("  FAILED  {0}: {1}" -f $name, $_.Exception.Message)
+        return $false
+    }
+    $a = (Get-FileHash -LiteralPath $Source -Algorithm SHA256).Hash
+    $b = (Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash
+    $ok = ($a -eq $b)
+    Write-Output ("  {0}  {1,-28} {2}  {3}" -f $(if ($ok) { 'OK    ' } else { 'MISMATCH' }),
+                  $name, ("{0:N0} B" -f (Get-Item -LiteralPath $target).Length), $a.Substring(0, 16))
+    return $ok
+}
+
+Write-Output '--- executables and runtime DLLs ---'
+$failures = 0
+foreach ($exe in Get-ChildItem -LiteralPath $apps -Filter '*.exe') {
+    if (-not (Copy-Verified -Source $exe.FullName -TargetDir $binDir)) { $failures++ }
+}
+foreach ($dll in Get-ChildItem -LiteralPath $apps -Filter '*.dll') {
