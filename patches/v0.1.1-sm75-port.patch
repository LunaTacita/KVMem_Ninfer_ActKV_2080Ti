+# ============================================================================
+# sm75 / KVMem 0.18 stack - DEEP cross-page probe (128K haystack + long decode).
+#
+# WHY 128K AND NOT 4K - the mistake this script exists to avoid
+#   The device pool holds B+R = 38400 tokens. Any prompt shorter than that is
+#   fully resident, so it never exercises retrieval, eviction, host tiering or
+#   the page re-selection path at all. A recall HIT on such a prompt proves
+#   only that full attention works; it says nothing about KVMem. The previous
+#   probe run had a 32K recall prompt (35784 < 38400, all resident) and a long
+#   decode whose prompt was 95 tokens - neither touched the mechanism.
+#   This probe uses a haystack several times the pool:
+#     * 128K tokens with N records scattered through it (default every ~10K),
+#       then asks for every record back: each record lives in a block that had
+#       to be evicted and re-selected from the host tier, so a lost record is a
+#       lost page.
+#     * the same haystack, then a LONG answer (default 8192 tokens) under a
+#       constraint that must hold at BOTH ends of the output: the first line
+#       and the last line must carry the SAME nonce, and the body must cite
+#       records from the far end of the haystack. A page swap that loses decode
+#       state shows up as a mismatched nonce, a wrong citation, or a loop.
+#
+# POOL-SIZE CEILING ON max_tokens (upstream handbook 04 section 3-L1)
+#   max_tokens must stay <= the pool token count. A 32000-token request against
+#   a small pool was observed to crash a worker with no self-heal. The long
+#   answer is therefore clamped to (B+R)/2 per lane.
+#
+# HOST AND DISK BUDGETS - what THIS stack does, read from the source
+#   HostKvStorage allocates with `new uint8_t[]` (host_kv_storage.cpp:371, :316),
+#   i.e. ORDINARY heap memory, NOT cudaHostAlloc pinned memory, and its
+#   constructor defaults the capacity to UINT64_MAX (host_kv_storage.hpp:114).
+#   There is therefore no locked-page ceiling in this stack: the previous
+#   stack's "31 GiB / 48.5% of RAM" figure belongs to a different host layer and
+#   must not be carried over (that layer's NINFER_HOST_PAGEABLE has zero hits in
+#   this tree - basis index C9).
+#   Measured on this model: host_payload_bytes 813,694,976 for 12,375 tokens is
+#   ~66 KiB per token, so 1M tokens is ~66 GiB of native KV - more than the
+#   63.9 GB of RAM. That is exactly why the disk tier must be enabled.
+#   SpillFile does NOT preallocate: it creates a sparse FILE_FLAG_DELETE_ON_CLOSE
+#   handle (spill_io.cpp:234-249, FSCTL_SET_SPARSE) and charges ranges only as
+#   they are used, so a large --kvmem-disk-mib costs no physical space until
+#   written and the file disappears when the process exits. The previous stack's
+#   DiskKVBridge preallocation trap (#40) does not apply here.
+#   Hence: most of the RAM as the host bound, a large sparse disk quota, and a
+#   full 1M logical ceiling; the haystack size is what the probe varies.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK: traps #20/#81).
+# Verdicts come from HTTP responses and the engine log, never ExitCode (N30).
+# ============================================================================
+param(
+    [string]$Model        = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [string]$Profile      = 'long',
+    [string]$Mtp          = 'off',
+    [int]$TargetTokens    = 131072,
+    [int]$Needles         = 12,
+    [int]$AskMax          = 1024,
+    [int]$LongMax         = 0,
+    [int]$Ctx             = 1048576,
+    [int]$HostMiB         = 49152,
+    [string]$DiskPath     = 'E:\AI\KVMem_Ninfer_Speed\Cache\kvmem',
+    [int]$DiskMiB         = 1048576,
+    [int]$Sessions        = 1,
+    [int]$Sink            = 4096,
+    [int]$Recent          = 1024,
+    [int]$Port            = 18200,
+    [int]$ReadySec        = 900,
+    [int]$GenTimeout      = 7200,
+    [string]$Tag          = 'deep',
+    [string]$BuildDir     = 'E:\AI\ninfer-fusion\kvmem_build',
+    # --- KV-format x window variables (added 2026-10-15) ---------------------
+    # -KvDtype picks the KV storage; -B / -R override the profile's device window
+    # so "does a bigger visible set actually recall more, and what does it cost"
+    # can be measured without editing the table. -GdnFp16 is the upstream Bonsai
+    # recipe's recurrent-state trade.
+    [string]$KvDtype      = '',
+    [switch]$GdnFp16,
+    [int]$B               = 0,
+    [int]$R               = 0
+)
+
+$ErrorActionPreference = 'Stop'
+
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+$TABLE = @{
+    'long' = @{ B = 32768; R = 5632; Lanes = 1 }
+    'dual' = @{ B = 16384; R = 2816; Lanes = 2 }
+    'max8' = @{ B = 3264;  R = 1536; Lanes = 8 }
+}
+if (-not $TABLE.ContainsKey($Profile)) { throw "unknown profile: $Profile" }
+$cfg = $TABLE[$Profile]
+# -B / -R override the profile's device window; the lane count stays the profile's.
+$poolB = if ($B -gt 0) { $B } else { $cfg.B }
+$poolR = if ($R -gt 0) { $R } else { $cfg.R }
+
+# The user's production rule is max_tokens = max_context / 2. On this stack the device pool
+# is the real ceiling for one request (a request longer than the pool has nowhere to append
+# into: the upstream handbook, section 3-L1, records a worker that crashed with no self-heal
+# when a 32,000-token request met a small pool). So the default is the pool's own half, and a
+# judgement must never fail because the OUTPUT BUDGET was too small: thinking tokens consume
+# it first, and an empty answer then looks like an engine defect (traps C17 / N57).
+$poolPerLane = [int](($poolB + $poolR) / $cfg.Lanes)
+$longCeiling = [int]($poolPerLane / 2)
+if ($LongMax -le 0) { $LongMax = $longCeiling }
+if ($LongMax -gt $longCeiling) {
+    Write-Output ("long max_tokens clamped {0} -> {1} (per-lane pool {2})" -f $LongMax, $longCeiling, $poolPerLane)
+    $LongMax = $longCeiling
+}
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ("profile    = {0}  B={1} R={2} lanes={3}  poolPerLane={4}" -f $Profile, $poolB, $poolR, $cfg.Lanes, $poolPerLane)
+Write-Output ("kv-dtype   = {0}   gdn-state-fp16 = {1}" -f $(if ($KvDtype -eq '') { '(default bf16)' } else { $KvDtype }), $GdnFp16)
+Write-Output ("haystack   = {0} tokens, {1} records, ask {2}, long decode {3}" -f $TargetTokens, $Needles, $AskMax, $LongMax)
+Write-Output ("host= {0} MiB  disk= {1} MiB  ctx= {2}  sessions={3}  mtp={4}" -f $HostMiB, $DiskMiB, $Ctx, $Sessions, $Mtp)
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 5
+}
+
+# Builds a haystack with unique filler (so no prefix cache can turn prefill into
+# a lookup) and records scattered at even intervals. Returns the text plus the
+# exact codes that must come back.
+function Build-Haystack {
+    param([int]$TargetTokens, [int]$Count, [string]$Salt)
+    $base = 'The quick brown fox jumps over the lazy dog. Ninfer on Turing keeps a bounded KV window and streams the rest from host memory through the tier. '
+    $sb = [System.Text.StringBuilder]::new()
+    $codes = @()
+    $every = [int]($TargetTokens / ($Count + 1))
+    $placed = 0
+    $i = 0
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        $approx = [int]($sb.Length / 4)
+        if ($placed -lt $Count -and $approx -ge ($every * ($placed + 1))) {
+            $placed++
+            $code = ('C' + $placed + $Salt + 'Q' + ($placed * 7 + 3))
+            $codes += $code
+            [void]$sb.Append(' IMPORTANT RECORD k='); [void]$sb.Append($placed)
+            [void]$sb.Append(' value='); [void]$sb.Append($code); [void]$sb.Append('. ')
+        }
+        [void]$sb.Append('u'); [void]$sb.Append($i); [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    return [pscustomobject]@{ Text = $sb.ToString(); Codes = $codes }
+}
+
+function Get-DoneLines {
+    param([string]$LogPath)
+    return @(Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+             Select-String -Pattern 'req#\d+ done')
+}
+
+function Invoke-Chat {
+    param([string]$Url, [hashtable]$Body, [string]$LogPath, [int]$TimeoutSec)
+    $before = (Get-DoneLines -LogPath $LogPath).Count
+    $json   = $Body | ConvertTo-Json -Depth 6
+    $sw     = [System.Diagnostics.Stopwatch]::StartNew()
+    $resp   = Invoke-RestMethod -Uri $Url -Method Post -ContentType 'application/json' `
+                -Body $json -TimeoutSec $TimeoutSec
+    $sw.Stop()
+    $deadline = (Get-Date).AddSeconds(120)
+    $lines = @()
+    while ((Get-Date) -lt $deadline) {
+        $lines = Get-DoneLines -LogPath $LogPath
+        if ($lines.Count -gt $before) { break }
+        Start-Sleep -Milliseconds 500
+    }
+    $done = if ($lines.Count -gt 0) { $lines[-1].Line.Trim() } else { '(no done line)' }
+    return [pscustomobject]@{ Resp = $resp; Wall = $sw.Elapsed.TotalSeconds; Done = $done }
+}
+
+function Test-Degenerate {
+    param([string]$Text)
+    if ([string]::IsNullOrWhiteSpace($Text)) { return 'EMPTY' }
+    $words = @($Text -split '\s+' | Where-Object { $_ -ne '' })
+    if ($words.Count -lt 40) { return 'SHORT' }
+    $counts = @{}
+    for ($i = 0; $i -le ($words.Count - 8); $i++) {
+        $k = ($words[$i..($i + 7)] -join ' ')
+        if ($counts.ContainsKey($k)) { $counts[$k] = $counts[$k] + 1 } else { $counts[$k] = 1 }
+    }
+    $max = ($counts.Values | Measure-Object -Maximum).Maximum
+    if ($max -ge 8) { return ('REPEAT-x' + $max) }
+    return 'OK'
+}
+
+Stop-Orphans
+
+$arm = '{0}_{1}_{2}' -f $Tag, $Profile, $Mtp
+$errLog = Join-Path $BuildDir ("$arm.server.err.log")
+$outLog = Join-Path $BuildDir ("$arm.server.out.log")
+Remove-Item -LiteralPath $errLog, $outLog -ErrorAction SilentlyContinue
+
+$argList = @($Model, '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+             '--max-context', "$Ctx", '--max-concurrency', "$($cfg.Lanes)",
+             '--kvmem-budget', "$poolB", '--kvmem-gen-reserve', "$poolR",
+             '--kvmem-host-mib', "$HostMiB", '--kvmem-sessions', "$Sessions",
+             '--kvmem-sink-tokens', "$Sink", '--kvmem-recent-tokens', "$Recent",
+             '--kvmem-disk-path', "$DiskPath", '--kvmem-disk-mib', "$DiskMiB",
+             '--log-level', 'info')
+if ($KvDtype -ne '') { $argList += @('--kv-dtype', $KvDtype) }
+if ($GdnFp16) { $argList += '--gdn-state-fp16' }
+if ($Mtp -eq 'mtp') { $argList += @('--spec', 'mtp', '--draft-tokens', '3') }
+Write-Output ('flags = ' + ($argList -join ' '))
+
+$t0 = Get-Date
+$proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+    -RedirectStandardOutput $outLog -RedirectStandardError $errLog -ArgumentList $argList
+
+$baseUrl  = "http://127.0.0.1:$Port"
+$ready    = $false
+$deadline = (Get-Date).AddSeconds($ReadySec)
+while ((Get-Date) -lt $deadline) {
+    if ($proc.HasExited) { break }
+    try { [void](Invoke-RestMethod -Uri "$baseUrl/health" -TimeoutSec 3); $ready = $true; break }
+    catch { Start-Sleep -Seconds 5 }
+}
+$readySec = [math]::Round(((Get-Date) - $t0).TotalSeconds, 1)
+
+if (-not $ready) {
+    Write-Output ("NOT-READY after {0}s" -f $readySec)
+    Get-Content -LiteralPath $errLog -ErrorAction SilentlyContinue |
+        Select-String -Pattern 'KVMem rejected|error|Error|FATAL|invalid|out of memory' |
+        Select-Object -Last 5 | ForEach-Object { Write-Output ('  ' + $_.Line.Trim()) }
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Write-Output 'RESULT: NOT-READY'
+    exit 1
+}
+
+$capText = @(Get-Content -LiteralPath $errLog -ErrorAction SilentlyContinue) |
+           Select-String -Pattern 'capacity \|' | Select-Object -Last 1
+Write-Output ('ready in {0}s' -f $readySec)
+if ($capText) { Write-Output ('  ' + $capText.Line.Trim()) }
+Write-Output ('  gpu = ' + ((& nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader) -join ' '))
+
+$modelId = 'local'
+try {
+    $m = Invoke-RestMethod -Uri "$baseUrl/v1/models" -TimeoutSec 10
+    if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+} catch { }
+$chatUrl = "$baseUrl/v1/chat/completions"
+
+$hay = Build-Haystack -TargetTokens $TargetTokens -Count $Needles -Salt ('S' + $Profile + $Mtp)
+Write-Output ("haystack chars = {0}, records = {1}" -f $hay.Text.Length, $hay.Codes.Count)
+Write-Output ('  codes: ' + ($hay.Codes -join ' '))
+
+# ---------------------------------------------------------------------------
+# 1) cross-page multi-record recall: the haystack is ~3.4x the pool, so every
+#    record sits in a block that was evicted and must be re-selected.
+# ---------------------------------------------------------------------------
+$askPrompt = $hay.Text + " TASK: the document above contains $Needles records of the form 'RECORD k=<index> value=<code>'. List every one as 'k=<index> value=<code>', one per line, ascending index. Output the list only, no preamble."
+$recallHits = 0
+$recallTotal = $hay.Codes.Count
+$recallFinish = 'n/a'
+$recallUsage = 'n/a'
+try {
+    $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+        model = $modelId
+        messages = @(@{ role = 'user'; content = $askPrompt })
+        max_tokens = $AskMax; stream = $false; temperature = 0.0
+    }
+    $answer = [string]$res.Resp.choices[0].message.content
+    $recallFinish = [string]$res.Resp.choices[0].finish_reason
+    $recallUsage = ($res.Resp.usage | ConvertTo-Json -Compress)
+    foreach ($c in $hay.Codes) { if ($answer -match [regex]::Escape($c)) { $recallHits++ } }
+    $shown = ($answer -replace "\s+", ' ')
+    if ($shown.Length -gt 300) { $shown = $shown.Substring(0, 300) }
+    Write-Output ("RECALL records {0}/{1}  finish={2}  wall={3:N1}s" -f $recallHits, $recallTotal, $recallFinish, $res.Wall)
+    Write-Output ('  usage: ' + $recallUsage)
+    Write-Output ('  answer: [' + $shown + ']')
+    Write-Output ('  done: ' + $res.Done)
+} catch { Write-Output ('RECALL FAILED: ' + $_.Exception.Message) }
+
+# ---------------------------------------------------------------------------
+# 2) long decode across page swaps, with a constraint that must hold at BOTH
+#    ends and citations that must survive from the far end of the haystack.
+# ---------------------------------------------------------------------------
+$nonce = 'VX' + (Get-Random -Minimum 10000 -Maximum 99999)
+$citeTargets = @($hay.Codes[-1], $hay.Codes[[int]($hay.Codes.Count / 2)], $hay.Codes[0])
+$longPrompt = $hay.Text + " TASK: write a long, structured technical analysis of how a bounded KV window with host tiering behaves under a 128K-token history. RULES: (1) your very first line must be exactly 'PLAN=$nonce'; (2) your very last line must be exactly 'VERIFY=$nonce'; (3) somewhere in the body, name these three records verbatim: $($citeTargets -join ', '); (4) do not repeat yourself."
+$longFinish = 'n/a'; $longComp = 'n/a'; $longReason = 'n/a'
+$planOk = 'n/a'; $verifyOk = 'n/a'; $nonceMatch = 'n/a'; $cited = 0; $degen = 'n/a'; $longWall = 'n/a'
+try {
+    $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+        model = $modelId
+        messages = @(@{ role = 'user'; content = $longPrompt })
+        max_tokens = $LongMax; stream = $false; temperature = 0.0
+    }
+    $text = [string]$res.Resp.choices[0].message.content
+    $longWall = [math]::Round($res.Wall, 1)
+    $longFinish = [string]$res.Resp.choices[0].finish_reason
+    $longComp = $res.Resp.usage.completion_tokens
+    $longReason = $res.Resp.usage.completion_tokens_details.reasoning_tokens
+    $degen = Test-Degenerate -Text $text
+    $first = (($text -split "`n") | Where-Object { $_.Trim() -ne '' } | Select-Object -First 1)
+    $last  = (($text -split "`n") | Where-Object { $_.Trim() -ne '' } | Select-Object -Last 1)
+    $planOk   = if ($first -match ('^PLAN=' + [regex]::Escape($nonce))) { 'YES' } else { 'NO' }
+    $verifyOk = if ($last  -match ('^VERIFY=' + [regex]::Escape($nonce))) { 'YES' } else { 'NO' }
+    # Capture each match separately: a second -match overwrites $Matches, so
+    # comparing $Matches[1] to itself (the first version of this line) is always
+    # true and tests nothing.
+    $planNonce   = if ($first -match 'PLAN=(\S+)') { $Matches[1] } else { '' }
+    $verifyNonce = if ($last  -match 'VERIFY=(\S+)') { $Matches[1] } else { '' }
+    $nonceMatch  = if ($planNonce -eq $nonce -and $verifyNonce -eq $nonce) { 'SAME' } else { ('DIFF plan=' + $planNonce + ' verify=' + $verifyNonce) }
+    foreach ($c in $citeTargets) { if ($text -match [regex]::Escape($c)) { $cited++ } }
+    Write-Output ("LONG wall={0:N1}s finish={1} comp={2} reason={3} degen={4}" -f $res.Wall, $longFinish, $longComp, $longReason, $degen)
+    Write-Output ("  PLAN-first={0}  VERIFY-last={1}  nonce={2}  cited {3}/{4}" -f $planOk, $verifyOk, $nonce, $cited, $citeTargets.Count)
+    Write-Output ('  first line: [' + $first + ']')
+    Write-Output ('  last  line: [' + $last + ']')
+    Write-Output ('  done: ' + $res.Done)
+} catch { Write-Output ('LONG FAILED: ' + $_.Exception.Message) }
+
+$loadJson = 'n/a'
+try {
+    $load = Invoke-RestMethod -Uri "$baseUrl/v1/load" -TimeoutSec 30
+    $loadJson = ($load.kvmem | ConvertTo-Json -Compress)
+    Write-Output ('/v1/load kvmem = ' + $loadJson)
+} catch { }
+
+if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+Start-Sleep -Seconds 3
+Stop-Orphans
+
+$row = [pscustomobject]@{
+    arm = $arm; profile = $Profile; mtp = $Mtp
+    target = $TargetTokens; needles = $Needles
+    ready_s = $readySec; capacity = if ($capText) { $capText.Line.Trim() } else { 'n/a' }
+    recall_hits = $recallHits; recall_total = $recallTotal
+    recall_finish = $recallFinish; recall_usage = $recallUsage
+    long_wall_s = $longWall; long_finish = $longFinish; long_comp = $longComp
+    long_reason = $longReason; long_degen = $degen
+    plan_first = $planOk; verify_last = $verifyOk; nonce = $nonce
+    cited = $cited; cite_total = $citeTargets.Count
+    load = $loadJson
+}
+$csv = Join-Path $BuildDir ($Tag + '_' + $Profile + '_' + $Mtp + '_summary.csv')
+$row | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
+Write-Output 'RESULT: DEEP-DONE'
diff --git a/sm75_eval/run_feature_sweep.ps1 b/sm75_eval/run_feature_sweep.ps1
new file mode 100644
index 0000000..d93ba3f
--- /dev/null
+++ b/sm75_eval/run_feature_sweep.ps1
@@ -0,0 +1,144 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - feature sweep: concurrency, sessions, LRFU,
+# transfer verification, SSD tier, MTP and DFlash2.
+#
+# One arm per server start, because each arm needs different flags. Every arm
+# reports what the engine's own log and /v1/load say, never an exit code (N30).
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK).
+# The disk path is pure ASCII on purpose: a non-ASCII profile/output path has
+# already broken tooling on this host (trap N83).
+# ============================================================================
+param(
+    [string]$Model      = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [int]$Ctx           = 32768,
+    [int]$KvmemBudget   = 4096,
+    [int]$KvmemReserve  = 1536,
+    [int]$HostMiB       = 8192,
+    [int]$DiskMiB       = 4096,
+    [string]$DiskPath   = 'E:\AI\ninfer-fusion\kvmem_build\kvmem_disk_tier',
+    [int]$ReadySec      = 600,
+    [int]$GenTimeoutSec = 600,
+    [string]$BuildDir   = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+if (-not (Test-Path -LiteralPath $DiskPath)) { New-Item -ItemType Directory -Path $DiskPath | Out-Null }
+
+$baseKvmem = @('--kvmem-budget', "$KvmemBudget", '--kvmem-gen-reserve', "$KvmemReserve",
+               '--kvmem-host-mib', "$HostMiB")
+
+function Get-LastMatching {
+    param([string]$LogPath, [string]$Pattern)
+    $line = Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+            Select-String -Pattern $Pattern | Select-Object -Last 1
+    if ($line) { return $line.Line.Trim() }
+    return '(none)'
+}
+
+function Invoke-Arm {
+    param([string]$Name, [string[]]$Extra, [int]$Port)
+
+    Write-Output ''
+    Write-Output ('================ ARM ' + $Name + ' ================')
+    $err = Join-Path $BuildDir ("feat_$Name.server.err.log")
+    $out = Join-Path $BuildDir ("feat_$Name.server.out.log")
+
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 2
+
+    $argList = @($Model, '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+                 '--max-context', "$Ctx", '--log-level', 'info') + $baseKvmem + $Extra
+    Write-Output ("flags = " + ($argList -join ' '))
+
+    $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+        -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $argList
+
+    $base     = "http://127.0.0.1:$Port"
+    $ready    = $false
+    $deadline = (Get-Date).AddSeconds($ReadySec)
+    while ((Get-Date) -lt $deadline) {
+        if ($proc.HasExited) { Write-Output 'EXITED-BEFORE-READY'; break }
+        try { $null = Invoke-RestMethod -Uri "$base/health" -TimeoutSec 3; $ready = $true; break }
+        catch { Start-Sleep -Seconds 4 }
+    }
+    if (-not $ready) {
+        Write-Output 'RESULT: NOT-READY'
+        Write-Output ('first line: ' + (Get-Content -LiteralPath $err -TotalCount 1 -ErrorAction SilentlyContinue))
+        if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+        return
+    }
+
+    $modelId = 'local'
+    try {
+        $m = Invoke-RestMethod -Uri "$base/v1/models" -TimeoutSec 10
+        if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+    } catch { }
+    Write-Output ("model id = " + $modelId)
+
+    $body = @{ model = $modelId
+               messages = @(@{ role = 'user'; content = 'Reply with exactly: FEATURE OK' })
+               max_tokens = 64; stream = $false } | ConvertTo-Json -Depth 5
+
+    # Two concurrent requests (arm A judges concurrency; harmless for the others).
+    $jobs = @()
+    foreach ($n in 1..2) {
+        $jobs += Start-Job -ScriptBlock {
+            param($u, $b, $t)
+            try {
+                $r = Invoke-RestMethod -Uri $u -Method Post -ContentType 'application/json' -Body $b -TimeoutSec $t
+                return @{ ok = $true; text = $r.choices[0].message.content; usage = ($r.usage | ConvertTo-Json -Compress) }
+            } catch { return @{ ok = $false; text = $_.Exception.Message; usage = '' } }
+        } -ArgumentList "$base/v1/chat/completions", $body, $GenTimeoutSec
+    }
+    $res = $jobs | Wait-Job | Receive-Job
+    $jobs | Remove-Job -Force
+    $idx = 0
+    foreach ($r in $res) {
+        $idx++
+        Write-Output ("  concurrent req {0}: ok={1} | {2}" -f $idx, $r.ok, $r.text)
+    }
+
+    # A follow-up request: the session reuse shows up as a cache percentage in the log.
+    try {
+        $body2 = @{ model = $modelId
+                    messages = @(@{ role = 'user'; content = 'Reply with exactly: FEATURE OK' },
+                                 @{ role = 'assistant'; content = 'FEATURE OK' },
+                                 @{ role = 'user'; content = 'Reply with exactly: SESSION OK' })
+                    max_tokens = 64; stream = $false } | ConvertTo-Json -Depth 5
+        $r2 = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+            -ContentType 'application/json' -Body $body2 -TimeoutSec $GenTimeoutSec
+        Write-Output ("  follow-up req  : " + $r2.choices[0].message.content)
+    } catch { Write-Output ("  follow-up req FAILED: " + $_.Exception.Message) }
+
+    Write-Output '  --- req done lines ---'
+    Get-Content -LiteralPath $err -ErrorAction SilentlyContinue |
+        Select-String -Pattern 'req#\d+ done' | ForEach-Object { '  ' + $_.Line.Trim() }
+    Write-Output '  --- capacity line ---'
+    Write-Output ('  ' + (Get-LastMatching -LogPath $err -Pattern 'capacity \|'))
+    Write-Output '  --- kvmem / disk / history counters ---'
+    try {
+        $load = Invoke-RestMethod -Uri "$base/v1/load" -TimeoutSec 10
+        if ($load.kvmem) { Write-Output ('  ' + ($load.kvmem | ConvertTo-Json -Compress)) }
+        Write-Output ('  capacity=' + ($load.capacity | ConvertTo-Json -Compress))
+    } catch { Write-Output ('  WARN /v1/load: ' + $_.Exception.Message) }
+    Write-Output '  --- warnings / errors ---'
+    $w = Get-Content -LiteralPath $err -ErrorAction SilentlyContinue |
+         Select-String -Pattern 'WARN|ERROR|FATAL|failed'
+    if ($w) { $w | Select-Object -Last 8 | ForEach-Object { '  ' + $_.Line.Trim() } } else { Write-Output '  (none)' }
+
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 2
+}
+
+Invoke-Arm -Name 'A_concurrency_sessions' -Port 18091 -Extra @('--max-concurrency', '2', '--kvmem-sessions', '4')
+Invoke-Arm -Name 'B_lrfu_verify_ssd'      -Port 18092 -Extra @('--kvmem-lrfu', '--kvmem-verify-transfers',
+                                                             '--kvmem-disk-path', $DiskPath, '--kvmem-disk-mib', "$DiskMiB")
+Invoke-Arm -Name 'C_mtp'                  -Port 18093 -Extra @('--spec', 'mtp', '--draft-tokens', '3')
+Invoke-Arm -Name 'D_dflash2'              -Port 18094 -Extra @('--spec', 'dflash2', '--draft-tokens', '3')
+
+Write-Output ''
+Write-Output 'RESULT: FEATURE-SWEEP-DONE'
diff --git a/sm75_eval/run_kvformat_speed.ps1 b/sm75_eval/run_kvformat_speed.ps1
new file mode 100644
index 0000000..6a5147b
--- /dev/null
+++ b/sm75_eval/run_kvformat_speed.ps1
@@ -0,0 +1,225 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - KV storage format x speed matrix.
+#
+# WHY THIS EXISTS
+#   The device pool is (B+R) x lanes tokens, and the storage format decides how
+#   many bytes each token costs: it is what makes or breaks "1M + MTP" on this
+#   card. Measured 2026-10-15 with B=32768 / R=5632 / lanes=1 / ctx=1M / MTP on:
+#     bf16    reservation 3.18 GiB -> REFUSED (only 2.75 GiB free after weights)
+#     int8    reservation 1.79 GiB -> free 845 MiB
+#     fp8     reservation 1.76 GiB -> free 847 MiB
+#     rk8v4   reservation 1.50 GiB -> free 1.09 GiB
+#     k8v4    reservation 1.48 GiB -> free 1.09 GiB
+#   Free memory is not the whole decision, so this script measures the part the
+#   format also changes: decode tok/s and prefill tok/s, back to back, with only
+#   the format varying.
+#
+# WHAT EVERY ARM REPORTS (from the engine's own words, never ExitCode, N30)
+#   ready seconds, the capacity line (pages / runtime / free), the memory ledger
+#   (after weights / slack), GPU used+free, decode tok/s, prefill tok/s on a 32K
+#   prompt whose every segment is unique (so prefix reuse cannot turn prefill
+#   into a lookup), and the full usage object of the recall-free decode.
+#
+# HOST LOAD - NOT SILENT, ON PURPOSE (user decision 2026-10-15): production
+#   conditions are the right conditions. A measurement is accepted only when the
+#   repeats AGREE; a disagreeing repeat is reported as SPREAD and never averaged.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK: traps #20/#81).
+# ============================================================================
+param(
+    [string]$Model = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [string[]]$KvDtypes = @('bf16', 'int8', 'fp8', 'rk8v4', 'k8v4'),
+    [switch]$GdnFp16,
+    [string]$Mtp = 'mtp',
+    [int]$B = 32768,
+    [int]$R = 5632,
+    [int]$Ctx = 1048576,
+    [int]$HostMiB = 49152,
+    [string]$DiskPath = 'E:\AI\KVMem_Ninfer_Speed\Cache\kvmem',
+    [int]$DiskMiB = 102400,
+    [int]$Sessions = 4,
+    [int]$Sink = 4096,
+    [int]$Recent = 1024,
+    [int]$PrefillTokens = 32768,
+    [int]$Repeats = 1,
+    [int]$BasePort = 18900,
+    [int]$ReadySec = 900,
+    [int]$GenTimeout = 3600,
+    [string]$Tag = 'kvfmt',
+    [string]$BuildDir = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ("window     = B {0} + R {1} = {2} tokens/lane | ctx {3} | mtp {4} | gdn-fp16 {5}" -f `
+    $B, $R, ($B + $R), $Ctx, $Mtp, $GdnFp16)
+Write-Output ("formats    = {0}  x repeats {1}" -f ($KvDtypes -join ','), $Repeats)
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 5
+}
+
+function Build-UniquePrompt {
+    param([int]$TargetTokens, [string]$Prefix)
+    $base = 'The quick brown fox jumps over the lazy dog. Ninfer on Turing keeps a bounded KV window and streams the rest from host memory. '
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append($Prefix); [void]$sb.Append('#'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    return $sb.ToString()
+}
+
+function Get-DoneLines {
+    param([string]$LogPath)
+    return @(Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+             Select-String -Pattern 'req#\d+ done')
+}
+
+function Get-LastMatching {
+    param([string]$LogPath, [string]$Pattern)
+    $line = Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+            Select-String -Pattern $Pattern | Select-Object -Last 1
+    if ($line) { return $line.Line.Trim() }
+    return '(none)'
+}
+
+function Get-GpuState {
+    $v = & nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader 2>$null
+    if ($v) { return ([string]$v).Trim() }
+    return 'n/a'
+}
+
+# Fires one chat completion and waits for the engine to write the matching
+# "req#N done" line, so tok/s always comes from the engine's own report.
+function Invoke-Chat {
+    param([string]$Url, [hashtable]$Body, [string]$LogPath, [int]$TimeoutSec)
+    $before = (Get-DoneLines -LogPath $LogPath).Count
+    $json   = $Body | ConvertTo-Json -Depth 6
+    $resp   = Invoke-RestMethod -Uri $Url -Method Post -ContentType 'application/json' `
+                -Body $json -TimeoutSec $TimeoutSec
+    $deadline = (Get-Date).AddSeconds(120)
+    $lines = @()
+    while ((Get-Date) -lt $deadline) {
+        $lines = Get-DoneLines -LogPath $LogPath
+        if ($lines.Count -gt $before) { break }
+        Start-Sleep -Milliseconds 500
+    }
+    $done = if ($lines.Count -gt 0) { $lines[-1].Line.Trim() } else { '(no done line)' }
+    return [pscustomobject]@{ Resp = $resp; Done = $done }
+}
+
+$rows = @()
+$armIndex = 0
+foreach ($dtype in $KvDtypes) {
+    for ($rep = 1; $rep -le $Repeats; $rep++) {
+        $armIndex++
+        $port = $BasePort + $armIndex
+        $arm = '{0}_{1}_r{2}' -f $Tag, $dtype, $rep
+        $errLog = Join-Path $BuildDir ("$arm.server.err.log")
+        $outLog = Join-Path $BuildDir ("$arm.server.out.log")
+        Remove-Item -LiteralPath $errLog, $outLog -ErrorAction SilentlyContinue
+        Stop-Orphans
+
+        Write-Output ('================ ARM {0} ================' -f $arm)
+        $childArgs = @($Model, '--host', '127.0.0.1', '--port', "$port", '--device-profile', 'off',
+                       '--max-context', "$Ctx", '--max-concurrency', '1',
+                       '--kvmem-budget', "$B", '--kvmem-gen-reserve', "$R",
+                       '--kvmem-host-mib', "$HostMiB", '--kvmem-disk-path', "$DiskPath",
+                       '--kvmem-disk-mib', "$DiskMiB", '--kvmem-sessions', "$Sessions",
+                       '--kvmem-sink-tokens', "$Sink", '--kvmem-recent-tokens', "$Recent",
+                       '--log-level', 'debug')
+        if ($dtype -ne '' -and $dtype -ne 'bf16') { $childArgs += @('--kv-dtype', $dtype) }
+        if ($GdnFp16) { $childArgs += '--gdn-state-fp16' }
+        if ($Mtp -eq 'mtp') { $childArgs += @('--spec', 'mtp', '--draft-tokens', '3') }
+
+        $row = [pscustomobject]@{
+            arm = $arm; dtype = $dtype; rep = $rep
+            ready_s = 'n/a'; capacity = 'n/a'; ledger = 'n/a'; gpu = 'n/a'
+            decode = 'n/a'; prefill = 'n/a'; usage = 'n/a'; note = ''
+        }
+
+        $t0 = Get-Date
+        $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+            -RedirectStandardOutput $outLog -RedirectStandardError $errLog -ArgumentList $childArgs
+        $baseUrl  = "http://127.0.0.1:$port"
+        $ready    = $false
+        $deadline = (Get-Date).AddSeconds($ReadySec)
+        while ((Get-Date) -lt $deadline) {
+            if ($proc.HasExited) { break }
+            try { [void](Invoke-RestMethod -Uri "$baseUrl/health" -TimeoutSec 3); $ready = $true; break }
+            catch { Start-Sleep -Seconds 4 }
+        }
+        $row.ready_s = [math]::Round(((Get-Date) - $t0).TotalSeconds, 1)
+
+        if (-not $ready) {
+            Write-Output ('  NOT-READY after {0}s' -f $row.ready_s)
+            Get-Content -LiteralPath $errLog -ErrorAction SilentlyContinue |
+                Select-String -Pattern 'KVMem rejected|requested Engine runtime reservation|it needs|can hold about|FATAL' |
+                Select-Object -Last 3 | ForEach-Object { Write-Output ('    ' + $_.Line.Trim()) }
+            $row.note = 'NOT-READY'
+            if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+            Start-Sleep -Seconds 5
+            $rows += $row
+            continue
+        }
+
+        $row.capacity = Get-LastMatching -LogPath $errLog -Pattern 'capacity \|'
+        $row.ledger   = Get-LastMatching -LogPath $errLog -Pattern 'memory ledger'
+        $row.gpu      = Get-GpuState
+        Write-Output ('  ' + $row.capacity)
+        Write-Output ('  ' + $row.ledger)
+
+        $modelId = 'local'
+        try {
+            $m = Invoke-RestMethod -Uri "$baseUrl/v1/models" -TimeoutSec 10
+            if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+        } catch { }
+        $chatUrl = "$baseUrl/v1/chat/completions"
+
+        try {
+            $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+                model = $modelId
+                messages = @(@{ role = 'user'; content = 'Count from 1 to 60, one number per line.' })
+                max_tokens = 256; stream = $false; temperature = 0.0
+            }
+            $row.usage = ($res.Resp.usage | ConvertTo-Json -Compress)
+            if ($res.Done -match 'decode ([\d.]+) tok/s') { $row.decode = $Matches[1] }
+            Write-Output ('  decode: ' + $res.Done)
+        } catch { $row.note += 'decodeFail;'; Write-Output ('  decode FAILED: ' + $_.Exception.Message) }
+
+        try {
+            $prompt = Build-UniquePrompt -TargetTokens $PrefillTokens -Prefix 'seg'
+            $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+                model = $modelId
+                messages = @(@{ role = 'user'; content = $prompt })
+                max_tokens = 8; stream = $false
+            }
+            if ($res.Done -match 'prefill ([\d.]+) tok/s') { $row.prefill = $Matches[1] }
+            Write-Output ('  prefill: ' + $res.Done)
+        } catch { $row.note += 'prefillFail;'; Write-Output ('  prefill FAILED: ' + $_.Exception.Message) }
+
+        if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+        Start-Sleep -Seconds 5
+        $rows += $row
+        Write-Output ''
+    }
+}
+
+Stop-Orphans
+Write-Output '================ KV FORMAT SPEED SUMMARY ================'
+$rows | Format-Table arm, ready_s, decode, prefill, gpu, note -AutoSize | Out-String | Write-Output
+$csv = Join-Path $BuildDir ($Tag + '_summary.csv')
+Remove-Item -LiteralPath $csv -ErrorAction SilentlyContinue
+$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
+Write-Output 'RESULT: KVFMT-DONE'
diff --git a/sm75_eval/run_kvmem_fit.ps1 b/sm75_eval/run_kvmem_fit.ps1
new file mode 100644
index 0000000..56df348
--- /dev/null
+++ b/sm75_eval/run_kvmem_fit.ps1
@@ -0,0 +1,151 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - acceptance for the "auto" fit of the Host and SSD
+# budgets, plus the ceiling report that replaces a crash (requirement R3).
+#
+# WHAT EACH ARM PROVES
+#   ACCEPT  : the round-19 quality knobs stay manual (B / R / sink / recent) while
+#             --kvmem-host-mib auto and --kvmem-disk-mib auto are fitted by the
+#             engine. The arm requires, in order:
+#               1. a "KVMem fit:" line for the Host budget,
+#               2. a "KVMem fit:" line for the SSD budget,
+#               3. a capacity line and a served request (talking is not enough,
+#                  so it asks for a real answer),
+#               and it records the fitted numbers so the log claim can be checked.
+#   CEILING : a tiny explicit Host against a 1M window must FAIL and name how many
+#             tokens this machine can hold. This is the negative control for the
+#             fit: without it, "auto worked" would only mean "nothing was tested".
+#             It also shows that an explicit value still overrides the fit.
+#   NOPATH  : --kvmem-disk-mib auto without --kvmem-disk-path must fail with the
+#             reason, because the engine cannot know which volume to measure.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK: traps #20/#81).
+# Verdicts come from log lines and HTTP responses, never ExitCode (N30).
+# ============================================================================
+param(
+    [string]$Model    = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [string]$DiskDir  = 'E:\AI\KVMem_Ninfer_Speed\Cache\kvmem',
+    [int]$Port        = 18300,
+    [int]$ReadySec    = 600,
+    [int]$GenTimeout  = 900,
+    [string]$Tag      = 'kvfit',
+    [string]$BuildDir = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 5
+}
+
+# Starts one arm and reports what the engine said, not whether a process existed.
+function Invoke-Arm {
+    param([string]$Name, [string[]]$Flags, [int]$Port, [bool]$ExpectReady)
+
+    Write-Output ('================ ARM ' + $Name + ' ================')
+    $err = Join-Path $BuildDir ("$Tag`_$Name.server.err.log")
+    $out = Join-Path $BuildDir ("$Tag`_$Name.server.out.log")
+    Remove-Item -LiteralPath $err, $out -ErrorAction SilentlyContinue
+    Stop-Orphans
+
+    Write-Output ('  flags = ' + (($Flags) -join ' '))
+    $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+        -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $Flags
+
+    $baseUrl  = "http://127.0.0.1:$Port"
+    $ready    = $false
+    $deadline = (Get-Date).AddSeconds($ReadySec)
+    while ((Get-Date) -lt $deadline) {
+        if ($proc.HasExited) { break }
+        try { [void](Invoke-RestMethod -Uri "$baseUrl/health" -TimeoutSec 3); $ready = $true; break }
+        catch { Start-Sleep -Seconds 3 }
+    }
+
+    $lines = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue)
+    $fit   = @($lines | Select-String -Pattern 'KVMem fit:')
+    $rej   = @($lines | Select-String -Pattern 'KVMem cannot hold|auto needs|auto cannot')
+
+    Write-Output ("  ready = {0}" -f $ready)
+    foreach ($line in $fit) { Write-Output ('  FIT   | ' + $line.Line.Trim()) }
+    foreach ($line in $rej) { Write-Output ('  REJECT| ' + $line.Line.Trim()) }
+
+    $answer = 'n/a'
+    if ($ready) {
+        $cap = @($lines | Select-String -Pattern 'capacity \|' | Select-Object -Last 1)
+        if ($cap) { Write-Output ('  ' + $cap.Line.Trim()) }
+        $modelId = 'local'
+        try {
+            $m = Invoke-RestMethod -Uri "$baseUrl/v1/models" -TimeoutSec 10
+            if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+        } catch { }
+        try {
+            $body = @{ model = $modelId
+                       messages = @(@{ role = 'user'; content = 'Reply with exactly: FIT OK' })
+                       max_tokens = 512; stream = $false } | ConvertTo-Json -Depth 5
+            $r = Invoke-RestMethod -Uri "$baseUrl/v1/chat/completions" -Method Post `
+                 -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+            $answer = [string]$r.choices[0].message.content
+            Write-Output ('  answer = ' + ($answer -replace "\s+", ' '))
+        } catch { Write-Output ('  REQUEST FAILED: ' + $_.Exception.Message) }
+    }
+
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 3
+
+    $verdict = if ($ExpectReady) {
+        if ($ready -and $fit.Count -ge 2 -and $answer -ne 'n/a') { 'PASS' } else { 'FAIL' }
+    } else {
+        if (-not $ready -and $rej.Count -ge 1) { 'PASS' } else { 'FAIL' }
+    }
+    Write-Output ("  VERDICT = {0}" -f $verdict)
+    Write-Output ''
+    return [pscustomobject]@{
+        arm = $Name; expect_ready = $ExpectReady; ready = $ready
+        fit_lines = $fit.Count; reject_lines = $rej.Count
+        answer = ($answer -replace "\s+", ' '); verdict = $verdict
+    }
+}
+
+# The round-19 quality knobs stay manual; only the two budgets are fitted.
+$quality = @('--kvmem-budget', '32768', '--kvmem-gen-reserve', '5632',
+             '--kvmem-sink-tokens', '4096', '--kvmem-recent-tokens', '1024')
+
+$rows = @()
+$rows += Invoke-Arm -Name 'ACCEPT' -Port $Port -ExpectReady $true -Flags (@($Model,
+    '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+    '--max-context', '1048576', '--max-concurrency', '1',
+    '--kvmem-host-mib', 'auto', '--kvmem-disk-path', $DiskDir, '--kvmem-disk-mib', 'auto',
+    '--kvmem-sessions', '1', '--log-level', 'info') + $quality)
+
+$rows += Invoke-Arm -Name 'CEILING' -Port ($Port + 1) -ExpectReady $false -Flags (@($Model,
+    '--host', '127.0.0.1', '--port', "$($Port + 1)", '--device-profile', 'off',
+    '--max-context', '1048576', '--max-concurrency', '1',
+    '--kvmem-host-mib', '1024',
+    '--kvmem-sessions', '1', '--log-level', 'info') + $quality)
+
+$rows += Invoke-Arm -Name 'NOPATH' -Port ($Port + 2) -ExpectReady $false -Flags (@($Model,
+    '--host', '127.0.0.1', '--port', "$($Port + 2)", '--device-profile', 'off',
+    '--max-context', '1048576', '--max-concurrency', '1',
+    '--kvmem-host-mib', 'auto', '--kvmem-disk-mib', 'auto',
+    '--kvmem-sessions', '1', '--log-level', 'info') + $quality)
+
+Stop-Orphans
+Write-Output '================ FIT ACCEPTANCE SUMMARY ================'
+$rows | Format-Table arm, expect_ready, ready, fit_lines, reject_lines, verdict -AutoSize | Out-String | Write-Output
+$csv = Join-Path $BuildDir ($Tag + '_summary.csv')
+Remove-Item -LiteralPath $csv -ErrorAction SilentlyContinue
+$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
+$verdicts = @($rows | Where-Object { $_ -is [pscustomobject] } | ForEach-Object { $_.verdict })
+if (@($verdicts | Where-Object { $_ -ne 'PASS' }).Count -eq 0) {
+    Write-Output 'RESULT: ALL-PASS'
+} else {
+    Write-Output 'RESULT: HAS-FAILURE'
+}
diff --git a/sm75_eval/run_kvpool_sweep.ps1 b/sm75_eval/run_kvpool_sweep.ps1
new file mode 100644
index 0000000..6d98cbc
--- /dev/null
+++ b/sm75_eval/run_kvpool_sweep.ps1
@@ -0,0 +1,221 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - device-pool (B) sweep, for choosing the KV pool
+# from measurements instead of copying the upstream 88-page recipe.
+#
+# WHY THIS EXISTS
+#   types.h:522        device_tokens() = selected_tokens(B) + reserve_tokens(R)
+#   serve_options.cpp:1852  kv_capacity = explicit_capacity(window * lanes)
+#   So --kvmem-budget is BOTH the attention-visible history size AND the number
+#   of device KV pages (pages = (B+R)*lanes/64). Growing B buys a longer visible
+#   history and pays for it in per-token attention cost: one knob, two faces.
+#   Upstream's B=4096/R=1536 (5632 tokens = 88 pages) is the window the previous
+#   stack happened to run 256K with, not a value chosen for this card.
+#
+# WHAT EACH ARM REPORTS
+#   pages / runtime MiB / free MiB   - the engine's own capacity line
+#   decode tok/s                     - a real short generation
+#   prefill tok/s on a LONG prompt   - every segment carries a unique index, so
+#                                      prefix reuse cannot hide the prefill cost
+#   middle-needle recall             - whether the larger visible history is
+#                                      actually reachable
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK).
+# Verdicts come from HTTP responses and log lines, never from ExitCode (trap N30).
+# ============================================================================
+param(
+    [int[]]$Budgets   = @(4096, 8192, 12288, 16384, 20480),
+    [int]$Reserve     = 1536,
+    [int]$Ctx         = 262144,
+    [int]$HostMiB     = 16384,
+    [int]$Sessions    = 4,
+    [int]$Port        = 18090,
+    [string]$Model    = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [int]$LongTokens  = 32768,
+    [int]$ReadySec    = 900,
+    [int]$GenTimeout  = 1800,
+    [string]$Tag      = 'kvpool',
+    [string]$BuildDir = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ("model      = {0}" -f $Model)
+Write-Output ("B sweep    = {0}   R = {1}   lanes = 1   long prompt = {2} tokens" -f ($Budgets -join ','), $Reserve, $LongTokens)
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 3
+}
+
+function Build-LongPrompt {
+    param([int]$TargetTokens)
+    # Every segment is unique ("seg<target>#<i>"), so no prefix of this prompt
+    # repeats: a prefix cache cannot turn prefill into a lookup.
+    $base = 'The quick brown fox jumps over the lazy dog. Ninfer on Turing keeps a bounded KV window and streams the rest from host memory. '
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append('seg'); [void]$sb.Append($TargetTokens); [void]$sb.Append('#'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    return $sb.ToString()
+}
+
+# A needle placed in the MIDDLE of the long prompt: with a larger visible set the
+# model should still find it, and a truncated window is visible as a wrong answer.
+function Build-NeedlePrompt {
+    param([int]$TargetTokens, [string]$Needle)
+    $base = 'Filler sentence about bounded KV windows, host tiers and Turing kernels. '
+    $half = [int]($TargetTokens / 2)
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($half * 4)) {
+        [void]$sb.Append('f'); [void]$sb.Append($i); [void]$sb.Append(' '); [void]$sb.Append($base); $i++
+    }
+    [void]$sb.Append(' IMPORTANT: the secret passphrase is '); [void]$sb.Append($Needle); [void]$sb.Append('. ')
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append('g'); [void]$sb.Append($i); [void]$sb.Append(' '); [void]$sb.Append($base); $i++
+    }
+    [void]$sb.Append(' Question: what is the secret passphrase? Answer with the passphrase only.')
+    return $sb.ToString()
+}
+
+$rows = @()
+
+foreach ($B in $Budgets) {
+    $arm = '{0}_b{1}' -f $Tag, $B
+    $err = Join-Path $BuildDir ("$arm.server.err.log")
+    $out = Join-Path $BuildDir ("$arm.server.out.log")
+    if (Test-Path -LiteralPath $err) { Remove-Item -LiteralPath $err -Force }
+    if (Test-Path -LiteralPath $out) { Remove-Item -LiteralPath $out -Force }
+
+    Stop-Orphans
+
+    $argList = @($Model, '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+                 '--max-context', "$Ctx", '--max-concurrency', '1',
+                 '--kvmem-budget', "$B", '--kvmem-gen-reserve', "$Reserve",
+                 '--kvmem-host-mib', "$HostMiB", '--kvmem-sessions', "$Sessions",
+                 '--log-level', 'info')
+    Write-Output ('--- arm {0}: B={1} R={2} ---' -f $arm, $B, $Reserve)
+
+    $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+        -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $argList
+
+    $base    = "http://127.0.0.1:$Port"
+    $ready   = $false
+    $t0      = Get-Date
+    $deadline = (Get-Date).AddSeconds($ReadySec)
+    while ((Get-Date) -lt $deadline) {
+        if ($proc.HasExited) { break }
+        try { [void](Invoke-RestMethod -Uri "$base/health" -TimeoutSec 3); $ready = $true; break }
+        catch { Start-Sleep -Seconds 5 }
+    }
+    $loadSec = [math]::Round(((Get-Date) - $t0).TotalSeconds, 1)
+
+    if (-not $ready) {
+        $tail = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) | Select-Object -Last 6
+        Write-Output ('  NOT-READY after {0}s' -f $loadSec)
+        foreach ($l in $tail) { Write-Output ('    ' + $l.Trim()) }
+        if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+        $rows += [pscustomobject]@{ B = $B; pages = 'n/a'; runtime = 'n/a'; free = 'n/a'; decode = 'n/a'; prefill = 'n/a'; recall = 'n/a'; note = 'NOT-READY' }
+        continue
+    }
+
+    Write-Output ('  ready in {0}s' -f $loadSec)
+
+    # --- capacity, from the engine's own line ---------------------------------
+    $capLine = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) |
+               Select-String -Pattern 'capacity \|' | Select-Object -Last 1
+    $capText = if ($capLine) { $capLine.Line.Trim() } else { '(no capacity line)' }
+    Write-Output ('  ' + $capText)
+
+    $pages = 'n/a'; $runtime = 'n/a'; $free = 'n/a'
+    if ($capText -match 'pages (\d+)/(\d+)') { $pages = $Matches[1] }
+    if ($capText -match 'runtime ([\d.]+) MiB') { $runtime = $Matches[1] }
+    if ($capText -match 'free ([\d.]+) GiB') { $free = $Matches[1] }
+
+    $modelId = 'local'
+    try {
+        $m = Invoke-RestMethod -Uri "$base/v1/models" -TimeoutSec 10
+        if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+    } catch { }
+
+    # --- decode speed ---------------------------------------------------------
+    $decode = 'n/a'
+    try {
+        $body = @{ model = $modelId
+                   messages = @(@{ role = 'user'; content = 'Count from 1 to 60, one number per line.' })
+                   max_tokens = 256; stream = $false; temperature = 0.0 } | ConvertTo-Json -Depth 5
+        $sw = [System.Diagnostics.Stopwatch]::StartNew()
+        $r = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+             -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+        $sw.Stop()
+        $done = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) |
+                Select-String -Pattern 'req#\d+ done' | Select-Object -Last 1
+        if ($done -and $done.Line -match 'decode ([\d.]+) tok/s') { $decode = $Matches[1] }
+        else { $decode = ('wall {0:N1}s' -f $sw.Elapsed.TotalSeconds) }
+        Write-Output ('  decode: ' + $done.Line.Trim())
+    } catch { Write-Output ('  decode FAILED: ' + $_.Exception.Message) }
+
+    # --- prefill speed on a long unique prompt --------------------------------
+    $prefill = 'n/a'
+    try {
+        $prompt = Build-LongPrompt -TargetTokens $LongTokens
+        $body = @{ model = $modelId
+                   messages = @(@{ role = 'user'; content = $prompt })
+                   max_tokens = 8; stream = $false } | ConvertTo-Json -Depth 5
+        $sw = [System.Diagnostics.Stopwatch]::StartNew()
+        $r = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+             -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+        $sw.Stop()
+        $done = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) |
+                Select-String -Pattern 'req#\d+ done' | Select-Object -Last 1
+        if ($done -and $done.Line -match 'prefill ([\d.]+) tok/s') { $prefill = $Matches[1] }
+        Write-Output ('  prefill: ' + $done.Line.Trim() + ('  (wall {0:N1}s)' -f $sw.Elapsed.TotalSeconds))
+    } catch { Write-Output ('  prefill FAILED: ' + $_.Exception.Message) }
+
+    # --- middle-needle recall -------------------------------------------------
+    # max_tokens is 512, NOT 32. With 32 this arm reported MISS on every budget
+    # and an empty message.content, which was misread as "KVMem retrieval does
+    # not work": thinking consumed the whole budget (reasoning_tokens was 56-83
+    # per request). run_recall_sweep.ps1 was fixed for this; this copy was not,
+    # which is trap N31 again (the same primitive with more than one private
+    # copy). finish_reason and the full usage object are printed for the same
+    # reason: a starved budget must be visible, not inferred.
+    $recall = 'n/a'
+    try {
+        $needle = 'ZQ7K3'
+        $prompt = Build-NeedlePrompt -TargetTokens $LongTokens -Needle $needle
+        $body = @{ model = $modelId
+                   messages = @(@{ role = 'user'; content = $prompt })
+                   max_tokens = 512; stream = $false; temperature = 0.0 } | ConvertTo-Json -Depth 5
+        $r = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+             -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+        $answer = [string]$r.choices[0].message.content
+        $finish = [string]$r.choices[0].finish_reason
+        $usage  = ($r.usage | ConvertTo-Json -Compress)
+        if ($answer -match $needle) { $recall = 'HIT' } else { $recall = 'MISS' }
+        Write-Output ('  recall: ' + $recall + '  finish=' + $finish + '  answer=' + ($answer -replace "\s+", ' ').Substring(0, [Math]::Min(60, $answer.Length)))
+        Write-Output ('    usage: ' + $usage)
+    } catch { Write-Output ('  recall FAILED: ' + $_.Exception.Message) }
+
+    $rows += [pscustomobject]@{ B = $B; pages = $pages; runtime = $runtime; free = $free; decode = $decode; prefill = $prefill; recall = $recall; note = '' }
+
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 3
+    Write-Output ''
+}
+
+Stop-Orphans
+Write-Output '================ SUMMARY ================'
+$rows | Format-Table -AutoSize | Out-String | Write-Output
+if (Test-Path -LiteralPath (Join-Path $BuildDir ($Tag + '_summary.csv'))) { Remove-Item -LiteralPath (Join-Path $BuildDir ($Tag + '_summary.csv')) -Force }
+$rows | Export-Csv -LiteralPath (Join-Path $BuildDir ($Tag + '_summary.csv')) -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + (Join-Path $BuildDir ($Tag + '_summary.csv')))
diff --git a/sm75_eval/run_longctx_kvmem.ps1 b/sm75_eval/run_longctx_kvmem.ps1
new file mode 100644
index 0000000..8efd91b
--- /dev/null
+++ b/sm75_eval/run_longctx_kvmem.ps1
@@ -0,0 +1,167 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - long-context (256K) acceptance AND prefill-scaling
+# judgement, in one run.
+#
+# WHY THESE FLAGS
+#   NO --kv-capacity HERE.  In this stack KVMem owns the device capacity: with
+#                           --kvmem-budget set, serve_options.cpp:1852 assigns
+#                           explicit_capacity(device_tokens * max_concurrency) itself, and
+#                           :1844 rejects ANY explicit --kv-capacity that is not exactly that
+#                           value - including "--kv-capacity auto". Passing the previous
+#                           stack's 256K recipe (which REQUIRES --kv-capacity auto, because
+#                           there the default is explicit_capacity(max_context)) fails here
+#                           with "KVMem requires aligned B/R, nonzero H, prefill <= R, and
+#                           device capacity B+R <= max-context". The idea carries over; the
+#                           spelling does not.
+#   --kvmem-budget 4096     selected history B (device window part 1)
+#   --kvmem-gen-reserve 1536 append workspace R (device window part 2)
+#                           B + R = 5632 device tokens, which is the 88-page window
+#                           the previous stack actually ran 256K with.
+#   --kvmem-host-mib 16384  host native KV payload, same order as the previous
+#                           stack's 16 GiB host tier. This host has 63.9 GB of RAM.
+#   --kvmem-sessions 4      also exercises the multi-session host tier.
+#   --device-profile off    the calibration sweep is unusable on this card.
+#
+# WHAT IT MEASURES
+#   * a real text answer (max_tokens 512), so "generation works" is shown and not assumed;
+#   * prefill tok/s at three prompt sizes with UNIQUE content, so prefix reuse cannot
+#     hide the prefill cost. Flat tok/s => attention cost per token is bounded;
+#     falling tok/s => the O(cursor^2) prefill behaviour the previous stack fixed with
+#     P62/P65 is present here too and must be re-implemented.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK).
+# Verdicts come from HTTP responses and log lines, never from ExitCode (trap N30).
+# ============================================================================
+param(
+    [string]$Model          = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [int]$Port              = 18085,
+    [int]$Ctx               = 262144,
+    [int]$KvmemBudget       = 4096,
+    [int]$KvmemReserve      = 1536,
+    [int]$HostMiB           = 16384,
+    [int]$Sessions          = 4,
+    [int[]]$Lens            = @(8192, 32768, 98304),
+    [int]$ReadySec          = 900,
+    [int]$GenTimeoutSec     = 1800,
+    [string]$Tag            = 'longctx_kvmem',
+    [string]$BuildDir       = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+$err = Join-Path $BuildDir "$Tag.server.err.log"
+$out = Join-Path $BuildDir "$Tag.server.out.log"
+
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+
+Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+    ForEach-Object { Write-Output ('killing orphan: ' + $_.Name); Stop-Process -Id $_.Id -Force }
+Start-Sleep -Seconds 2
+
+$argList = @($Model, '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+             '--max-context', "$Ctx", '--max-concurrency', '1',
+             '--kvmem-budget', "$KvmemBudget", '--kvmem-gen-reserve', "$KvmemReserve",
+             '--kvmem-host-mib', "$HostMiB", '--kvmem-sessions', "$Sessions",
+             '--log-level', 'info')
+Write-Output ("flags      = " + ($argList -join ' '))
+
+$proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+    -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $argList
+
+$base     = "http://127.0.0.1:$Port"
+$ready    = $false
+$deadline = (Get-Date).AddSeconds($ReadySec)
+while ((Get-Date) -lt $deadline) {
+    if ($proc.HasExited) { Write-Output 'server exited before becoming ready'; break }
+    try {
+        $h = Invoke-RestMethod -Uri "$base/health" -TimeoutSec 3
+        $ready = $true
+        Write-Output ("health     = " + ($h | ConvertTo-Json -Compress))
+        break
+    } catch { Start-Sleep -Seconds 5 }
+}
+
+if (-not $ready) {
+    Write-Output 'RESULT: NOT-READY'
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 2
+    Write-Output '--- server stderr tail 40 ---'
+    Get-Content -LiteralPath $err -Tail 40 -ErrorAction SilentlyContinue
+    exit 1
+}
+
+$modelId = 'local'
+try {
+    $m = Invoke-RestMethod -Uri "$base/v1/models" -TimeoutSec 10
+    if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+    Write-Output ("model id   = " + $modelId)
+} catch { Write-Output ("WARN /v1/models: " + $_.Exception.Message) }
+
+Write-Output '--- /v1/load (capacity: the long-context judgement) ---'
+try {
+    $load = Invoke-RestMethod -Uri "$base/v1/load" -TimeoutSec 10
+    Write-Output ($load | ConvertTo-Json -Compress -Depth 6)
+} catch { Write-Output ("WARN /v1/load: " + $_.Exception.Message) }
+
+function Get-LastDone {
+    param([string]$LogPath)
+    $line = Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+            Select-String -Pattern 'req#\d+ done' | Select-Object -Last 1
+    if ($line) { return $line.Line.Trim() }
+    return '(no req#N done line yet)'
+}
+
+# --- 1) a real answer: proves generation, not just an HTTP 200 -------------------------------
+Write-Output ''
+Write-Output '--- answer sanity (max_tokens 512) ---'
+$body = @{ model = $modelId
+           messages = @(@{ role = 'user'; content = 'Reply with exactly: KVMEM SM75 LONG OK' })
+           max_tokens = 512; stream = $false } | ConvertTo-Json -Depth 5
+try {
+    $r = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+        -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeoutSec
+    Write-Output ("answer     = " + $r.choices[0].message.content)
+    Write-Output ("usage      = " + ($r.usage | ConvertTo-Json -Compress))
+} catch { Write-Output ("ANSWER REQUEST FAILED: " + $_.Exception.Message) }
+Write-Output ("log        = " + (Get-LastDone -LogPath $err))
+
+# --- 2) prefill scaling: unique content per size, so prefix reuse cannot hide the cost -------
+$base_text = 'The quick brown fox jumps over the lazy dog. Ninfer on Turing keeps a bounded KV window and streams the rest from host memory. '
+Write-Output ''
+Write-Output '--- prefill scaling (unique content per size) ---'
+foreach ($target in $Lens) {
+    $sb = [System.Text.StringBuilder]::new()
+    $chars = $target * 4
+    $i = 0
+    while ($sb.Length -lt $chars) {
+        [void]$sb.Append('seg'); [void]$sb.Append($target); [void]$sb.Append('#'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base_text)
+        $i++
+    }
+    $prompt = $sb.ToString()
+    $body = @{ model = $modelId
+               messages = @(@{ role = 'user'; content = $prompt })
+               max_tokens = 8; stream = $false } | ConvertTo-Json -Depth 5
+    $sw = [System.Diagnostics.Stopwatch]::StartNew()
+    try {
+        $r = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+            -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeoutSec
+        $sw.Stop()
+        Write-Output ("target {0,7} tokens | prompt_tokens {1,7} | wall {2,7:N1}s | {3}" -f `
+            $target, $r.usage.prompt_tokens, $sw.Elapsed.TotalSeconds, (Get-LastDone -LogPath $err))
+    } catch {
+        $sw.Stop()
+        Write-Output ("target {0,7} tokens | FAILED after {1:N1}s: {2}" -f $target, $sw.Elapsed.TotalSeconds, $_.Exception.Message)
+    }
+}
+
+if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+Start-Sleep -Seconds 2
+Write-Output ''
+Write-Output '--- capacity / kvmem / warning lines from stderr ---'
+Get-Content -LiteralPath $err -ErrorAction SilentlyContinue |
+    Where-Object { $_ -match 'capacity \||kvmem|WARN|ERROR|FATAL|reservation|host KV|context cache' } |
+    Select-Object -Last 30
diff --git a/sm75_eval/run_ppl_kv18.ps1 b/sm75_eval/run_ppl_kv18.ps1
new file mode 100644
index 0000000..8e3c4a0
--- /dev/null
+++ b/sm75_eval/run_ppl_kv18.ps1
@@ -0,0 +1,121 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - perplexity judgement, LIKE-FOR-LIKE with the
+# previous stack's accepted baseline.
+#
+# WHY THESE EXACT ARGUMENTS (do not "improve" them):
+#   The previous stack's last eight accepted runs (ppl_r16/r17/r18) all used
+#   this same artifact and this same argument set and produced:
+#     261,167 tokens | 124 windows | PPL 5.62563..5.62685 | [ALIGN] lines 0
+#   The engine's own run-to-run spread is about +-0.0006, so the bar for this
+#   stack is: 124/124 windows, PPL inside 5.626 +- 0.001, zero [ALIGN] lines.
+#   Changing the artifact or the context/stride makes the numbers incomparable.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK).
+# The verdict comes from LOG CONTENT, never from Start-Process.ExitCode: under
+# PS 5.1 with -NoNewWindow + redirection that property can come back empty and
+# misreport a pass as a failure (trap N30).
+# Two log channels on purpose (trap N17): stdout carries the device [ALIGN]
+# self-report and the result table, stderr the progress and CUDA_CHECK failures.
+# --stride must stay < --context (trap #77). --output must be explicit, or the
+# engine writes its report into F:\Trae_Projact\profiles\ (trap #78).
+#
+# The device profile is NOT installed by default (trap N74). The hand-authored
+# sm75-empty-routes.profile.json is schema v1 while this build reads only schema
+# v2, so forcing it through NINFER_DEVICE_PROFILES made the engine ignore the
+# file, recalibrate, and REPLACE it inside the source tree (+734 lines measured
+# 2026-10-15). Calibration is safe on this card now (67 routes in 31 s), so the
+# engine calibrates itself and writes nothing into the repository unless
+# -DeviceProfile points at a v2 file the caller owns.
+# ============================================================================
+param([int]$Runs = 8, [string]$Tag = 'ppl_kv18', [string]$KvDtype = '', [switch]$GdnFp16,
+      [string]$DeviceProfile = '')
+
+$ErrorActionPreference = 'Stop'
+$R       = 'E:\AI\ninfer-fusion'
+$exe     = Join-Path $R 'kvmem_build\apps\ninfer-perplexity.exe'
+$model   = 'E:\AI\ninfer-models\bonsai-mtponly.ninfer'
+$corpus  = Join-Path $R 'kvmem_src\eval\corpora\perplexity-1m\manifest.json'
+
+foreach ($p in @($exe, $model, $corpus)) {
+    if (-not (Test-Path -LiteralPath $p)) { throw "MISSING INPUT: $p" }
+}
+if ($DeviceProfile -ne '' -and -not (Test-Path -LiteralPath $DeviceProfile)) {
+    throw "MISSING INPUT: $DeviceProfile"
+}
+
+# Anchor the binary by hash: the "build <id>" string in the log comes from a
+# cmake stamp target that does NOT refresh on every rebuild, so it cannot say
+# what actually ran.
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ("model      = {0}" -f $model)
+Write-Output ("profile    = {0}" -f $(if ($DeviceProfile -eq '') { '(none; the engine calibrates itself)' } else { $DeviceProfile }))
+
+# Orphaned workers from a previous arm hold several GB of VRAM and would change
+# the memory picture of this arm.
+Get-Process -Name 'ninfer-perplexity', 'ninfer-serve', 'ninfer' -ErrorAction SilentlyContinue |
+    ForEach-Object { Write-Output ('killing orphan: ' + $_.Name + ' pid=' + $_.Id); Stop-Process -Id $_.Id -Force }
+Start-Sleep -Seconds 2
+
+# The hand-authored profile is schema v1 and this build reads only schema v2, so
+# forcing it made the engine ignore the file, recalibrate, and REPLACE it inside
+# the source tree (+734 lines, measured 2026-10-15). Calibration is safe on this
+# card now (67 routes in 31 s), so the profile is opt-in: without it the engine
+# calibrates and writes nothing into the repository.
+if ($DeviceProfile -ne '') { $env:NINFER_DEVICE_PROFILES = $DeviceProfile }
+$env:NINFER_CUDA_SYNC       = 'auto'
+
+$pass = 0
+for ($i = 1; $i -le $Runs; $i++) {
+    $name = '{0}_{1}' -f $Tag, $i
+    $out  = Join-Path $R ('kvmem_build\' + $name + '.out.log')
+    $err  = Join-Path $R ('kvmem_build\' + $name + '.err.log')
+    $od   = Join-Path $R ('kvmem_build\' + $name)
+    if (Test-Path -LiteralPath $out) { Remove-Item -LiteralPath $out -Force }
+    if (Test-Path -LiteralPath $err) { Remove-Item -LiteralPath $err -Force }
+
+    $sw = [System.Diagnostics.Stopwatch]::StartNew()
+    # -KvDtype / -GdnFp16 are the ONLY variables this matrix adds: the artifact, context,
+    # stride, corpus and output stay byte-identical to the accepted baseline, so a PPL
+    # difference is a KV-format difference and nothing else.
+    $childArgs = @($model, '--corpus', $corpus, '--quick', '--context', '4096',
+                   '--stride', '2048', '--output', $od, '--log-level', 'info')
+    if ($KvDtype -ne '') { $childArgs += @('--kv-dtype', $KvDtype) }
+    if ($GdnFp16) { $childArgs += '--gdn-state-fp16' }
+    $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+        -RedirectStandardOutput $out -RedirectStandardError $err `
+        -ArgumentList $childArgs
+    $proc.WaitForExit()
+    $sw.Stop()
+
+    $errLines = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue)
+    $outLines = @(Get-Content -LiteralPath $out -ErrorAction SilentlyContinue)
+
+    $bad  = $errLines | Select-String -Pattern 'misaligned|CUDA_CHECK.*failed|failed:' | Select-Object -Last 1
+    $good = $errLines | Select-String -Pattern 'scoring complete' | Select-Object -Last 1
+    $tbl  = @(@($outLines) + @($errLines) | Select-String -Pattern 'PPL|perplexity')
+
+    if ($good) { $ok = 'PASS'; $pass++ } else { $ok = 'FAIL' }
+
+    $align = @(@($outLines) + @($errLines) | Select-String -Pattern '\[ALIGN\]')
+
+    $detail = 'no verdict'
+    if ($bad) { $detail = $bad.Line.Trim() } elseif ($good) { $detail = $good.Line.Trim() }
+    Write-Output ('{0} | {1} | {2:N0}s | {3}' -f $name, $ok, $sw.Elapsed.TotalSeconds, $detail)
+    Write-Output ('    [ALIGN] report lines: {0}' -f $align.Count)
+    foreach ($t in ($tbl | Select-Object -Last 3)) { Write-Output ('    ' + $t.Line.Trim()) }
+
+    if ($align.Count -gt 0) {
+        $grouped = $align | ForEach-Object {
+            if ($_.Line -match '\[ALIGN\]\s+(\S+)\s+need=(\d+)\s+smod=(\d+)\s+src=(\S+)\s+srcmod=(\d+)') {
+                '{0} need={1} smod={2} srcmod={3}' -f $Matches[1], $Matches[2], $Matches[3], $Matches[5]
+            } else { $_.Line.Trim() }
+        } | Group-Object | Sort-Object Count -Descending
+        foreach ($g in ($grouped | Select-Object -First 25)) {
+            Write-Output ('      {0,8}x  {1}' -f $g.Count, $g.Name)
+        }
+    }
+}
+
+Write-Output ('==== pass {0}/{1} ====' -f $pass, $Runs)
+if ($pass -eq $Runs) { Write-Output 'RESULT: ALL-PASS' } else { Write-Output 'RESULT: HAS-FAILURE' }
diff --git a/sm75_eval/run_prefill_pairs.ps1 b/sm75_eval/run_prefill_pairs.ps1
new file mode 100644
index 0000000..97ed3ef
--- /dev/null
+++ b/sm75_eval/run_prefill_pairs.ps1
@@ -0,0 +1,194 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - prefill/decode measurement for chosen (B, R) pairs,
+# taken under PRODUCTION host load.
+#
+# WHY A SEPARATE SCRIPT
+#   The first two sweeps ran while other work was executing on this host, and
+#   the numbers prove it: B=36864 measured prefill 423.7 tok/s and B=32768
+#   measured 210.7 tok/s on the same 34,648-token prompt, i.e. the larger pool
+#   looked twice as fast. That is a host-load artifact, not a KVMem property.
+#   Those prefill numbers are void; this script re-measures the same pairs.
+#
+# HOST LOAD - NOT SILENT, ON PURPOSE (user decision, 2026-10-15)
+#   Production conditions are the right conditions. Edge and the production
+#   apps stay open, because a judgement that only holds on a quiet host does not
+#   describe the machine the user actually runs. Trap N48 is kept as the
+#   mechanism warning it always was - the host can move a prefill number by 2x -
+#   so each arm records a host-load snapshot and a number is only acted on when
+#   a repeat agrees with it. A disagreement is reported, never averaged away.
+#
+# WHAT IT MEASURES PER (B, R)
+#   the engine's own capacity line (pages / runtime / free)
+#   decode tok/s on a short generation
+#   prefill tok/s on a long prompt whose every segment is unique, so prefix
+#   reuse cannot turn prefill into a lookup
+#
+# RATIONALE FOR THE PAIRS
+#   Upstream recommends a retrieval budget of 36864 (36K) or 32768 (32K) with a
+#   generation reserve of 16384 / 12288 on a 16 GiB card, whose measured peak
+#   left only 460-606 MiB free - upstream fills the card too. On this 11 GB card
+#   B+R=38400 already leaves 235 MiB free and B+R=42496 collapses (prefill
+#   1.8 tok/s), so upstream's B+R does not fit and B must be traded against R.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK).
+# Verdicts come from HTTP responses and log lines, never from ExitCode (N30).
+# ============================================================================
+param(
+    [string[]]$Pairs   = @('4096:1536', '32768:1536', '32768:5632', '28672:8192'),
+    [int]$Ctx         = 262144,
+    [int]$HostMiB     = 16384,
+    [int]$Sessions    = 4,
+    [int]$Sink        = 4096,
+    [int]$Recent      = 1024,
+    [int]$Port        = 18096,
+    [string]$Model    = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [int]$LongTokens  = 32768,
+    [int]$ReadySec    = 900,
+    [int]$GenTimeout  = 1800,
+    [string]$Tag      = 'prefillpairs',
+    [string]$BuildDir = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("pairs (B:R) = {0}" -f ($Pairs -join ' | '))
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 3
+}
+
+# The measurement is taken under production load, so the load itself is part of
+# the evidence: when a repeat disagrees, this snapshot says whether the host
+# moved rather than leaving it to guesswork.
+function Get-HostSnapshot {
+    $gpu  = & nvidia-smi --query-gpu=memory.used,memory.free,utilization.gpu --format=csv,noheader 2>$null
+    $proc = @(Get-Process).Count
+    return ('gpu[' + ([string]$gpu).Trim() + '] procs=' + $proc)
+}
+
+function Build-UniquePrompt {
+    param([int]$TargetTokens)
+    $base = 'The quick brown fox jumps over the lazy dog. Ninfer on Turing keeps a bounded KV window and streams the rest from host memory. '
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append('u'); [void]$sb.Append($TargetTokens); [void]$sb.Append('#'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    return $sb.ToString()
+}
+
+$rows = @()
+
+foreach ($pair in $Pairs) {
+    $parts = $pair -split ':'
+    $B = [int]$parts[0]; $R = [int]$parts[1]
+    $arm = '{0}_b{1}_r{2}' -f $Tag, $B, $R
+    $err = Join-Path $BuildDir ("$arm.server.err.log")
+    $out = Join-Path $BuildDir ("$arm.server.out.log")
+    Remove-Item -LiteralPath $err, $out -ErrorAction SilentlyContinue
+
+    Stop-Orphans
+
+    $argList = @($Model, '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+                 '--max-context', "$Ctx", '--max-concurrency', '1',
+                 '--kvmem-budget', "$B", '--kvmem-gen-reserve', "$R",
+                 '--kvmem-host-mib', "$HostMiB", '--kvmem-sessions', "$Sessions",
+                 '--kvmem-sink-tokens', "$Sink", '--kvmem-recent-tokens', "$Recent",
+                 '--log-level', 'info')
+    Write-Output ('--- arm {0} ---' -f $arm)
+
+    $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+        -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $argList
+
+    $baseUrl  = "http://127.0.0.1:$Port"
+    $ready    = $false
+    $deadline = (Get-Date).AddSeconds($ReadySec)
+    while ((Get-Date) -lt $deadline) {
+        if ($proc.HasExited) { break }
+        try { [void](Invoke-RestMethod -Uri "$baseUrl/health" -TimeoutSec 3); $ready = $true; break }
+        catch { Start-Sleep -Seconds 5 }
+    }
+
+    if (-not $ready) {
+        Write-Output '  NOT-READY'
+        Get-Content -LiteralPath $err -ErrorAction SilentlyContinue | Select-String -Pattern 'capacity \||KVMem rejected|error|FATAL' |
+            Select-Object -Last 3 | ForEach-Object { Write-Output ('    ' + $_.Line.Trim()) }
+        if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+        $rows += [pscustomobject]@{ B = $B; R = $R; pages = 'n/a'; free = 'n/a'; decode = 'n/a'; prefill = 'n/a'; note = 'NOT-READY' }
+        continue
+    }
+
+    $cap = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) | Select-String -Pattern 'capacity \|' | Select-Object -Last 1
+    $capText = if ($cap) { $cap.Line.Trim() } else { '(no capacity line)' }
+    Write-Output ('  ' + $capText)
+    Write-Output ('  host load: ' + (Get-HostSnapshot))
+    $pages = 'n/a'; $free = 'n/a'
+    if ($capText -match 'pages (\d+)/(\d+)') { $pages = $Matches[1] }
+    if ($capText -match 'free ([\d.]+) (GiB|MiB|B)') { $free = ($Matches[1] + ' ' + $Matches[2]) }
+
+    $modelId = 'local'
+    try {
+        $m = Invoke-RestMethod -Uri "$baseUrl/v1/models" -TimeoutSec 10
+        if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+    } catch { }
+
+    # --- decode ---------------------------------------------------------------
+    $decode = 'n/a'
+    try {
+        $body = @{ model = $modelId
+                   messages = @(@{ role = 'user'; content = 'Count from 1 to 60, one number per line.' })
+                   max_tokens = 256; stream = $false; temperature = 0.0 } | ConvertTo-Json -Depth 5
+        $sw = [System.Diagnostics.Stopwatch]::StartNew()
+        # NOT $r: PowerShell variable names are case-insensitive (trap N46), so a local
+        # $r would overwrite the $R parameter that names the generation reserve.
+        $resp = Invoke-RestMethod -Uri "$baseUrl/v1/chat/completions" -Method Post `
+             -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+        $sw.Stop()
+        $done = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) |
+                Select-String -Pattern 'req#\d+ done' | Select-Object -Last 1
+        if ($done -and $done.Line -match 'decode ([\d.]+) tok/s') { $decode = $Matches[1] }
+        else { $decode = ('wall {0:N1}s' -f $sw.Elapsed.TotalSeconds) }
+        Write-Output ('  decode : ' + $done.Line.Trim())
+    } catch { Write-Output ('  decode FAILED: ' + $_.Exception.Message) }
+
+    # --- prefill on a long, unique prompt -------------------------------------
+    $prefill = 'n/a'
+    try {
+        $prompt = Build-UniquePrompt -TargetTokens $LongTokens
+        $body = @{ model = $modelId
+                   messages = @(@{ role = 'user'; content = $prompt })
+                   max_tokens = 8; stream = $false } | ConvertTo-Json -Depth 5
+        $sw = [System.Diagnostics.Stopwatch]::StartNew()
+        # NOT $r: PowerShell variable names are case-insensitive (trap N46), so a local
+        # $r would overwrite the $R parameter that names the generation reserve.
+        $resp = Invoke-RestMethod -Uri "$baseUrl/v1/chat/completions" -Method Post `
+             -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+        $sw.Stop()
+        $done = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) |
+                Select-String -Pattern 'req#\d+ done' | Select-Object -Last 1
+        if ($done -and $done.Line -match 'prefill ([\d.]+) tok/s') { $prefill = $Matches[1] }
+        Write-Output ('  prefill: ' + $done.Line.Trim() + ('  (wall {0:N1}s)' -f $sw.Elapsed.TotalSeconds))
+    } catch { Write-Output ('  prefill FAILED: ' + $_.Exception.Message) }
+
+    $rows += [pscustomobject]@{ B = $B; R = $R; pages = $pages; free = $free; decode = $decode; prefill = $prefill; note = '' }
+
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 3
+    Write-Output ''
+}
+
+Stop-Orphans
+Write-Output '================ PRODUCTION SUMMARY ================'
+$rows | Format-Table -AutoSize | Out-String | Write-Output
+$csv = Join-Path $BuildDir ($Tag + '_summary.csv')
+Remove-Item -LiteralPath $csv -ErrorAction SilentlyContinue
+$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
diff --git a/sm75_eval/run_profile_matrix.ps1 b/sm75_eval/run_profile_matrix.ps1
new file mode 100644
index 0000000..aaeffed
--- /dev/null
+++ b/sm75_eval/run_profile_matrix.ps1
@@ -0,0 +1,362 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - KV profile matrix: the three decided profiles with
+# MTP off and on, repeated, so every number is like-for-like.
+#
+# WHY THIS SCRIPT EXISTS
+#   Round 19 locked the R mechanism (R=1536 -> prefill 210-228 tok/s; R>=5632 ->
+#   444-492; R=12288 saturates) and decided three profiles whose (B+R)*lanes is
+#   always 38400. But no script ever ran those three profiles back to back, and
+#   every judgement script passed neither --spec mtp nor --kvmem-sink-tokens /
+#   --kvmem-recent-tokens. So round 19's decode 40.3-40.8 and round 18's 50.2
+#   (no MTP) / 68.6 (MTP) describe DIFFERENT configurations; the difference was
+#   never an engine regression. This script removes that ambiguity by measuring
+#   one matrix with only two variables:
+#       profile in {long, dual, max8}  x  mtp in {off, mtp}  x  repeats
+#
+# HOST LOAD - NOT SILENT, ON PURPOSE (user decision, 2026-10-15)
+#   Production environment conditions are the right conditions: Edge and the
+#   production apps stay open; a judgement that only passes on a quiet host does
+#   not describe the machine the user actually runs. Trap N48 is kept as the
+#   mechanism warning it always was - the host can move a prefill number by 2x -
+#   so a measurement is accepted only when the repeats AGREE. A disagreeing
+#   repeat is reported as SPREAD and never averaged away.
+#
+# WHAT EVERY ARM REPORTS (all from the engine's own words, never ExitCode, N30)
+#   ready seconds, capacity line (pages / runtime / free), GPU used/free
+#   decode tok/s on a short generation
+#   prefill tok/s on a 32K prompt whose every segment is unique (prefix reuse
+#     cannot turn prefill into a lookup)
+#   middle-needle recall at 4K (control) and 32K, with finish_reason and the
+#     full usage object so a thinking-starved budget cannot be misread as a
+#     recall failure (trap C17)
+#   a production-grade long decode: 1024 max tokens, wall time, decode tok/s,
+#     completion/reasoning tokens, finish_reason, and a repetition check
+#   mtp accepted X/Y when MTP is on
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK and then throws
+# "Unexpected token" or silently runs nothing; traps #20 / #81 / N54).
+# One port per arm: two servers on one port split requests (trap #73).
+# ============================================================================
+param(
+    [string]$Model           = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [string[]]$Profiles      = @('long', 'dual', 'max8'),
+    [string[]]$MtpModes      = @('off', 'mtp'),
+    [int]$Repeats            = 2,
+    [int]$Ctx                = 262144,
+    [int]$Sink               = 4096,
+    [int]$Recent             = 1024,
+    [int]$HostMiB            = 16384,
+    [int]$Sessions           = 4,
+    [int]$BasePort           = 18100,
+    [int]$LongTokens         = 32768,
+    # 4096, not 1024. Thinking occupies the output budget, so a 1024 cap can be
+    # consumed entirely by reasoning and leave message.content empty: the probe
+    # arm returned comp 1024 / reasoning 1024 / finish length / text head [].
+    # The upstream handbook (04, sections 1.8 OVER_BUDGET, 2 and 3-L1) records
+    # this as established and forbids "fixing" long thinking by lowering
+    # max_tokens - that only turns "thinking too long" into "zero answer text".
+    # Keep max_tokens <= the pool token count (38400 for every profile here).
+    [int]$DecodeMaxTokens    = 4096,
+    [int]$ReadySec           = 900,
+    [int]$GenTimeout         = 3600,
+    [string]$Tag             = 'profmtx',
+    [string]$BuildDir        = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+# Binary is anchored by hash and mtime: the "build <id>" string in the log comes
+# from a cmake stamp target that does not refresh on every rebuild.
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ("host load  = PRODUCTION (not silent; Edge/apps stay open by user decision)")
+Write-Output ("matrix     = profiles[{0}] x mtp[{1}] x repeats {2}" -f ($Profiles -join ','), ($MtpModes -join ','), $Repeats)
+Write-Output ''
+
+# The three decided profiles. (B+R)*lanes == 38400 for all three, which is the
+# device-pool ceiling measured on this 11 GB card (free 236 MiB at that size;
+# B+R=42496 collapsed to prefill 1.8 tok/s, trap N50).
+$TABLE = @{
+    'long' = @{ B = 32768; R = 5632; Lanes = 1 }
+    'dual' = @{ B = 16384; R = 2816; Lanes = 2 }
+    'max8' = @{ B = 3264;  R = 1536; Lanes = 8 }
+}
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 5
+}
+
+function Build-UniquePrompt {
+    param([int]$TargetTokens, [string]$Prefix)
+    $base = 'The quick brown fox jumps over the lazy dog. Ninfer on Turing keeps a bounded KV window and streams the rest from host memory. '
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append($Prefix); [void]$sb.Append('#'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    return $sb.ToString()
+}
+
+function Build-Needle {
+    param([int]$TargetTokens, [string]$Needle, [string]$Salt)
+    $base = 'Filler about bounded KV windows, host tiers and Turing kernels. '
+    $half = [int]($TargetTokens / 2)
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($half * 4)) {
+        [void]$sb.Append($Salt); [void]$sb.Append('a'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    [void]$sb.Append(' IMPORTANT: the secret passphrase is '); [void]$sb.Append($Needle); [void]$sb.Append('. ')
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append($Salt); [void]$sb.Append('b'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    [void]$sb.Append(' Question: what is the secret passphrase? Reply with the passphrase only.')
+    return $sb.ToString()
+}
+
+function Get-DoneLines {
+    param([string]$LogPath)
+    return @(Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+             Select-String -Pattern 'req#\d+ done')
+}
+
+function Get-LastMatching {
+    param([string]$LogPath, [string]$Pattern)
+    $line = Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+            Select-String -Pattern $Pattern | Select-Object -Last 1
+    if ($line) { return $line.Line.Trim() }
+    return '(none)'
+}
+
+function Get-GpuState {
+    $v = & nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader 2>$null
+    if ($v) { return ([string]$v).Trim() }
+    return 'n/a'
+}
+
+# Fires one chat completion and waits for the engine to write the matching
+# "req#N done" line, so the tok/s always comes from the engine's own report and
+# not from a wall-clock guess.
+function Invoke-Chat {
+    param([string]$Url, [hashtable]$Body, [string]$LogPath, [int]$TimeoutSec)
+    $before = (Get-DoneLines -LogPath $LogPath).Count
+    $json   = $Body | ConvertTo-Json -Depth 6
+    $sw     = [System.Diagnostics.Stopwatch]::StartNew()
+    $resp   = Invoke-RestMethod -Uri $Url -Method Post -ContentType 'application/json' `
+                -Body $json -TimeoutSec $TimeoutSec
+    $sw.Stop()
+    $deadline = (Get-Date).AddSeconds(90)
+    $lines = @()
+    while ((Get-Date) -lt $deadline) {
+        $lines = Get-DoneLines -LogPath $LogPath
+        if ($lines.Count -gt $before) { break }
+        Start-Sleep -Milliseconds 500
+    }
+    $done = if ($lines.Count -gt 0) { $lines[-1].Line.Trim() } else { '(no done line)' }
+    return [pscustomobject]@{ Resp = $resp; Wall = $sw.Elapsed.TotalSeconds; Done = $done }
+}
+
+# A production-grade long answer that degenerates into a loop would otherwise
+# read as "the long decode worked". 8-gram repetition is the cheapest detector.
+function Test-Degenerate {
+    param([string]$Text)
+    if ([string]::IsNullOrWhiteSpace($Text)) { return 'EMPTY' }
+    $words = @($Text -split '\s+' | Where-Object { $_ -ne '' })
+    if ($words.Count -lt 40) { return 'SHORT' }
+    $counts = @{}
+    for ($i = 0; $i -le ($words.Count - 8); $i++) {
+        $k = ($words[$i..($i + 7)] -join ' ')
+        if ($counts.ContainsKey($k)) { $counts[$k] = $counts[$k] + 1 } else { $counts[$k] = 1 }
+    }
+    $max = ($counts.Values | Measure-Object -Maximum).Maximum
+    if ($max -ge 8) { return ('REPEAT-x' + $max) }
+    return 'OK'
+}
+
+$rows = @()
+$armIndex = 0
+
+foreach ($prof in $Profiles) {
+    if (-not $TABLE.ContainsKey($prof)) { throw "unknown profile: $prof" }
+    $cfg = $TABLE[$prof]
+
+    foreach ($mtp in $MtpModes) {
+        for ($rep = 1; $rep -le $Repeats; $rep++) {
+
+            $armIndex++
+            $port = $BasePort + $armIndex
+            $arm  = '{0}_{1}_{2}_r{3}' -f $Tag, $prof, $mtp, $rep
+            $errLog = Join-Path $BuildDir ("$arm.server.err.log")
+            $outLog = Join-Path $BuildDir ("$arm.server.out.log")
+            Remove-Item -LiteralPath $errLog, $outLog -ErrorAction SilentlyContinue
+
+            Write-Output ('================ ARM {0} ================' -f $arm)
+            Write-Output ('  B={0} R={1} lanes={2} port={3} sink={4} recent={5} mtp={6}' -f `
+                $cfg.B, $cfg.R, $cfg.Lanes, $port, $Sink, $Recent, $mtp)
+
+            Stop-Orphans
+
+            $argList = @($Model, '--host', '127.0.0.1', '--port', "$port", '--device-profile', 'off',
+                         '--max-context', "$Ctx", '--max-concurrency', "$($cfg.Lanes)",
+                         '--kvmem-budget', "$($cfg.B)", '--kvmem-gen-reserve', "$($cfg.R)",
+                         '--kvmem-host-mib', "$HostMiB", '--kvmem-disk-path', 'E:\AI\KVMem_Ninfer_Speed\Cache\kvmem', '--kvmem-disk-mib', '102400', '--kvmem-sessions', "$Sessions",
+                         '--kvmem-sink-tokens', "$Sink", '--kvmem-recent-tokens', "$Recent",
+                         '--log-level', 'info')
+            if ($mtp -eq 'mtp') { $argList += @('--spec', 'mtp', '--draft-tokens', '3') }
+            Write-Output ('  flags = ' + ($argList -join ' '))
+
+            $row = [pscustomobject]@{
+                arm = $arm; profile = $prof; mtp = $mtp; rep = $rep
+                B = $cfg.B; R = $cfg.R; lanes = $cfg.Lanes
+                ready_s = 'n/a'; pages = 'n/a'; runtime_MiB = 'n/a'; pool_free = 'n/a'
+                gpu_used_free = 'n/a'; decode_short = 'n/a'; prefill = 'n/a'
+                prefill_wall_s = 'n/a'; recall_4k = 'n/a'; recall_32k = 'n/a'
+                finish_32k = 'n/a'; usage_32k = 'n/a'
+                long_wall_s = 'n/a'; long_decode = 'n/a'; long_finish = 'n/a'
+                long_comp_tok = 'n/a'; long_reason_tok = 'n/a'; long_degen = 'n/a'
+                mtp_accept = 'n/a'; note = ''
+            }
+
+            $t0 = Get-Date
+            $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+                -RedirectStandardOutput $outLog -RedirectStandardError $errLog -ArgumentList $argList
+
+            $baseUrl  = "http://127.0.0.1:$port"
+            $ready    = $false
+            $deadline = (Get-Date).AddSeconds($ReadySec)
+            while ((Get-Date) -lt $deadline) {
+                if ($proc.HasExited) { break }
+                try { [void](Invoke-RestMethod -Uri "$baseUrl/health" -TimeoutSec 3); $ready = $true; break }
+                catch { Start-Sleep -Seconds 5 }
+            }
+            $row.ready_s = [math]::Round(((Get-Date) - $t0).TotalSeconds, 1)
+
+            if (-not $ready) {
+                Write-Output ('  NOT-READY after {0}s' -f $row.ready_s)
+                Get-Content -LiteralPath $errLog -ErrorAction SilentlyContinue |
+                    Select-String -Pattern 'KVMem rejected|error|Error|FATAL|invalid|out of memory' |
+                    Select-Object -Last 3 | ForEach-Object { Write-Output ('    ' + $_.Line.Trim()) }
+                if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+                $row.note = 'NOT-READY'
+                $rows += $row
+                Start-Sleep -Seconds 3
+                continue
+            }
+
+            # --- the engine's own capacity line + the real GPU picture ----------
+            $capText = Get-LastMatching -LogPath $errLog -Pattern 'capacity \|'
+            Write-Output ('  ' + $capText)
+            if ($capText -match 'pages (\d+)/(\d+)') { $row.pages = $Matches[1] }
+            if ($capText -match 'runtime ([\d.]+) MiB') { $row.runtime_MiB = $Matches[1] }
+            if ($capText -match 'free ([\d.]+) (GiB|MiB|B)') { $row.pool_free = ($Matches[1] + ' ' + $Matches[2]) }
+            $row.gpu_used_free = Get-GpuState
+            Write-Output ('  gpu used/free = ' + $row.gpu_used_free)
+
+            $modelId = 'local'
+            try {
+                $m = Invoke-RestMethod -Uri "$baseUrl/v1/models" -TimeoutSec 10
+                if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+            } catch { }
+            Write-Output ('  model id = ' + $modelId)
+
+            $chatUrl = "$baseUrl/v1/chat/completions"
+
+            # --- 1) short decode ----------------------------------------------
+            try {
+                $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+                    model = $modelId
+                    messages = @(@{ role = 'user'; content = 'Count from 1 to 60, one number per line.' })
+                    max_tokens = 256; stream = $false; temperature = 0.0
+                }
+                if ($res.Done -match 'decode ([\d.]+) tok/s') { $row.decode_short = $Matches[1] }
+                Write-Output ('  decode short: ' + $res.Done)
+            } catch { Write-Output ('  decode short FAILED: ' + $_.Exception.Message); $row.note += 'decodeShortFail;' }
+
+            # --- 2) prefill on a long unique prompt ---------------------------
+            try {
+                $prompt = Build-UniquePrompt -TargetTokens $LongTokens -Prefix 'seg'
+                $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+                    model = $modelId
+                    messages = @(@{ role = 'user'; content = $prompt })
+                    max_tokens = 8; stream = $false
+                }
+                $row.prefill_wall_s = [math]::Round($res.Wall, 1)
+                if ($res.Done -match 'prefill ([\d.]+) tok/s') { $row.prefill = $Matches[1] }
+                Write-Output ('  prefill: ' + $res.Done + ('  (wall {0:N1}s)' -f $res.Wall))
+            } catch { Write-Output ('  prefill FAILED: ' + $_.Exception.Message); $row.note += 'prefillFail;' }
+
+            # --- 3) middle-needle recall, 4K control then 32K ------------------
+            foreach ($len in @(4096, $LongTokens)) {
+                $needle = ('ZQ' + $cfg.B + 'X' + $len)
+                try {
+                    $prompt = Build-Needle -TargetTokens $len -Needle $needle -Salt ('n' + $prof + $mtp + $rep)
+                    $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+                        model = $modelId
+                        messages = @(@{ role = 'user'; content = $prompt })
+                        max_tokens = 512; stream = $false; temperature = 0.0
+                    }
+                    $answer = [string]$res.Resp.choices[0].message.content
+                    $finish = [string]$res.Resp.choices[0].finish_reason
+                    $usage  = ($res.Resp.usage | ConvertTo-Json -Compress)
+                    $hit    = if ($answer -match [regex]::Escape($needle)) { 'HIT' } else { 'MISS' }
+                    Write-Output ('  needle@{0,6}: {1} | finish={2} | wall={3:N1}s' -f $len, $hit, $finish, $res.Wall)
+                    Write-Output ('      usage: ' + $usage)
+                    if ($len -eq 4096) { $row.recall_4k = $hit } else { $row.recall_32k = $hit; $row.finish_32k = $finish; $row.usage_32k = $usage }
+                } catch { Write-Output ('  needle@{0,6}: FAILED {1}' -f $len, $_.Exception.Message) }
+            }
+
+            # --- 4) production-grade long decode ------------------------------
+            try {
+                $res = Invoke-Chat -Url $chatUrl -LogPath $errLog -TimeoutSec $GenTimeout -Body @{
+                    model = $modelId
+                    messages = @(@{ role = 'user'; content = 'Write a detailed technical explanation, in at least 700 words, of how paged KV caches work in large language model inference: block tables, page allocation, eviction, and host/disk tiering.' })
+                    max_tokens = $DecodeMaxTokens; stream = $false; temperature = 0.0
+                }
+                $text = [string]$res.Resp.choices[0].message.content
+                $row.long_wall_s    = [math]::Round($res.Wall, 1)
+                $row.long_finish    = [string]$res.Resp.choices[0].finish_reason
+                $row.long_comp_tok  = $res.Resp.usage.completion_tokens
+                $row.long_reason_tok = $res.Resp.usage.completion_tokens_details.reasoning_tokens
+                $row.long_degen     = Test-Degenerate -Text $text
+                if ($res.Done -match 'decode ([\d.]+) tok/s') { $row.long_decode = $Matches[1] }
+                Write-Output ('  long decode: wall={0:N1}s finish={1} comp={2} reason={3} degen={4}' -f `
+                    $res.Wall, $row.long_finish, $row.long_comp_tok, $row.long_reason_tok, $row.long_degen)
+                Write-Output ('    done: ' + $res.Done)
+                Write-Output ('    text head: [' + (($text -replace "\s+", ' ')).Substring(0, [Math]::Min(120, ($text -replace "\s+", ' ').Length)) + ']')
+            } catch { Write-Output ('  long decode FAILED: ' + $_.Exception.Message); $row.note += 'longDecodeFail;' }
+
+            # --- 5) MTP acceptance --------------------------------------------
+            if ($mtp -eq 'mtp') {
+                $row.mtp_accept = Get-LastMatching -LogPath $errLog -Pattern 'mtp accepted'
+                Write-Output ('  ' + $row.mtp_accept)
+            }
+
+            if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+            Start-Sleep -Seconds 3
+            $rows += $row
+            Write-Output ''
+        }
+    }
+}
+
+Stop-Orphans
+Write-Output '================ PROFILE MATRIX SUMMARY ================'
+$rows | Format-Table arm, ready_s, pages, pool_free, decode_short, prefill, recall_4k, recall_32k, long_decode, long_degen, mtp_accept -AutoSize |
+    Out-String | Write-Output
+
+$csv = Join-Path $BuildDir ($Tag + '_summary.csv')
+Remove-Item -LiteralPath $csv -ErrorAction SilentlyContinue
+$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
+Write-Output 'RESULT: PROFILE-MATRIX-DONE'
diff --git a/sm75_eval/run_recall_sweep.ps1 b/sm75_eval/run_recall_sweep.ps1
new file mode 100644
index 0000000..a74127f
--- /dev/null
+++ b/sm75_eval/run_recall_sweep.ps1
@@ -0,0 +1,170 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - recall sweep with diagnostics, and a probe for the
+# largest usable B (the first sweep showed B=20480 still had 1.20 GiB free).
+#
+# WHY THE PREVIOUS RECALL NUMBERS WERE VOID
+#   run_kvpool_sweep.ps1 asked for max_tokens 32 and got an empty answer on every
+#   arm. The previous round already recorded this failure mode: with thinking on,
+#   a 32-token budget is consumed entirely by reasoning and message.content comes
+#   back empty - it says nothing about recall. So this script:
+#     * asks for 512 tokens,
+#     * prints finish_reason and the full usage object (reasoning tokens included),
+#     * runs a SHORT (4K) needle first as a control: if the short one hits and the
+#       long one misses, the miss is a real long-context result; if both miss, the
+#       judgement itself is still wrong and the numbers must not be used.
+#
+# WHY BIGGER B IS STILL ON THE TABLE
+#   At B=20480 the engine reported 344/344 pages, runtime 1.67 GiB and free
+#   1.20 GiB, so the pool has room left. Decode did not move across the whole
+#   sweep; only prefill did, and it flattened above B=16384. Whether a larger
+#   visible set actually improves recall is exactly what this script measures.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK).
+# Verdicts come from HTTP responses and log lines, never from ExitCode (N30).
+# ============================================================================
+param(
+    [int[]]$Budgets   = @(4096, 12288, 20480, 28672, 36864),
+    [int]$Reserve     = 1536,
+    [int]$Ctx         = 262144,
+    [int]$HostMiB     = 16384,
+    [int]$Sessions    = 4,
+    [int]$Port        = 18094,
+    [string]$Model    = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [int]$ShortTokens = 4096,
+    [int]$LongTokens  = 32768,
+    [int]$ReadySec    = 900,
+    [int]$GenTimeout  = 2400,
+    [string]$Tag      = 'recall',
+    [string]$BuildDir = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("B sweep    = {0}   R = {1}   needles at {2} and {3} tokens" -f ($Budgets -join ','), $Reserve, $ShortTokens, $LongTokens)
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 3
+}
+
+function Build-Needle {
+    param([int]$TargetTokens, [string]$Needle, [int]$Salt)
+    $base = 'Filler about bounded KV windows, host tiers and Turing kernels. '
+    $half = [int]($TargetTokens / 2)
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    $tag = 'n' + $Salt
+    while ($sb.Length -lt ($half * 4)) {
+        [void]$sb.Append($tag); [void]$sb.Append('a'); [void]$sb.Append($i); [void]$sb.Append(' '); [void]$sb.Append($base); $i++
+    }
+    [void]$sb.Append(' IMPORTANT: the secret passphrase is '); [void]$sb.Append($Needle); [void]$sb.Append('. ')
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append($tag); [void]$sb.Append('b'); [void]$sb.Append($i); [void]$sb.Append(' '); [void]$sb.Append($base); $i++
+    }
+    [void]$sb.Append(' Question: what is the secret passphrase? Reply with the passphrase only.')
+    return $sb.ToString()
+}
+
+$rows = @()
+
+foreach ($B in $Budgets) {
+    $arm = '{0}_b{1}' -f $Tag, $B
+    $err = Join-Path $BuildDir ("$arm.server.err.log")
+    $out = Join-Path $BuildDir ("$arm.server.out.log")
+    Remove-Item -LiteralPath $err, $out -ErrorAction SilentlyContinue
+
+    Stop-Orphans
+
+    $argList = @($Model, '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+                 '--max-context', "$Ctx", '--max-concurrency', '1',
+                 '--kvmem-budget', "$B", '--kvmem-gen-reserve', "$Reserve",
+                 '--kvmem-host-mib', "$HostMiB", '--kvmem-sessions', "$Sessions",
+                 '--log-level', 'info')
+    Write-Output ('--- arm {0} ---' -f $arm)
+
+    $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+        -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $argList
+
+    $baseUrl  = "http://127.0.0.1:$Port"
+    $ready    = $false
+    $deadline = (Get-Date).AddSeconds($ReadySec)
+    while ((Get-Date) -lt $deadline) {
+        if ($proc.HasExited) { break }
+        try { [void](Invoke-RestMethod -Uri "$baseUrl/health" -TimeoutSec 3); $ready = $true; break }
+        catch { Start-Sleep -Seconds 5 }
+    }
+
+    if (-not $ready) {
+        $cap = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) | Select-String -Pattern 'capacity \|' | Select-Object -Last 1
+        if ($cap) { Write-Output ('  ' + $cap.Line.Trim()) }
+        $reason = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) |
+                  Select-String -Pattern 'KVMem rejected|error|Error|FATAL|invalid' | Select-Object -Last 2
+        foreach ($l in $reason) { Write-Output ('  ' + $l.Line.Trim()) }
+        Write-Output '  NOT-READY (this arm is above the device-pool limit)'
+        if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+        $rows += [pscustomobject]@{ B = $B; pages = 'n/a'; free = 'n/a'; short = 'n/a'; long = 'n/a'; note = 'NOT-READY' }
+        continue
+    }
+
+    $cap = @(Get-Content -LiteralPath $err -ErrorAction SilentlyContinue) | Select-String -Pattern 'capacity \|' | Select-Object -Last 1
+    $capText = if ($cap) { $cap.Line.Trim() } else { '(no capacity line)' }
+    Write-Output ('  ' + $capText)
+    $pages = 'n/a'; $free = 'n/a'
+    if ($capText -match 'pages (\d+)/(\d+)') { $pages = $Matches[1] }
+    if ($capText -match 'free ([\d.]+) GiB') { $free = $Matches[1] }
+
+    $modelId = 'local'
+    try {
+        $m = Invoke-RestMethod -Uri "$baseUrl/v1/models" -TimeoutSec 10
+        if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+    } catch { }
+
+    $results = @{}
+    $salt = 0
+    foreach ($len in @($ShortTokens, $LongTokens)) {
+        $salt++
+        $needle = ('ZQ' + $B + 'X' + $len)
+        try {
+            $prompt = Build-Needle -TargetTokens $len -Needle $needle -Salt $salt
+            $body = @{ model = $modelId
+                       messages = @(@{ role = 'user'; content = $prompt })
+                       max_tokens = 512; stream = $false; temperature = 0.0 } | ConvertTo-Json -Depth 5
+            $sw = [System.Diagnostics.Stopwatch]::StartNew()
+            $r = Invoke-RestMethod -Uri "$baseUrl/v1/chat/completions" -Method Post `
+                 -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+            $sw.Stop()
+            $answer  = [string]$r.choices[0].message.content
+            $finish  = [string]$r.choices[0].finish_reason
+            $usage   = $r.usage | ConvertTo-Json -Compress
+            $hit = if ($answer -match [regex]::Escape($needle)) { 'HIT' } else { 'MISS' }
+            $shown = ($answer -replace "\s+", ' ')
+            if ($shown.Length -gt 90) { $shown = $shown.Substring(0, 90) }
+            Write-Output ('  needle@{0,6} : {1} | finish={2} | wall={3:N1}s' -f $len, $hit, $finish, $sw.Elapsed.TotalSeconds)
+            Write-Output ('      usage: ' + $usage)
+            Write-Output ('      answer: [' + $shown + ']')
+            $results[$len] = $hit
+        } catch {
+            Write-Output ('  needle@{0,6} : FAILED {1}' -f $len, $_.Exception.Message)
+            $results[$len] = 'ERR'
+        }
+    }
+
+    $rows += [pscustomobject]@{ B = $B; pages = $pages; free = $free; short = $results[$ShortTokens]; long = $results[$LongTokens]; note = '' }
+
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 3
+    Write-Output ''
+}
+
+Stop-Orphans
+Write-Output '================ RECALL SUMMARY ================'
+$rows | Format-Table -AutoSize | Out-String | Write-Output
+$csv = Join-Path $BuildDir ($Tag + '_summary.csv')
+Remove-Item -LiteralPath $csv -ErrorAction SilentlyContinue
+$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
diff --git a/sm75_eval/run_smoke_kvmem.ps1 b/sm75_eval/run_smoke_kvmem.ps1
new file mode 100644
index 0000000..81258f9
--- /dev/null
+++ b/sm75_eval/run_smoke_kvmem.ps1
@@ -0,0 +1,118 @@
+﻿# ============================================================================
+# sm75 / KVMem 0.18 stack - serving smoke test.
+# Adapted from the round-16 script (tmp project ..._sm75全栈通路修复_20261014).
+# Lives in the repo on purpose: judgement scripts kept being reinvented every
+# round because they only ever lived in the memory system's temp area.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK and then either
+# throws "Unexpected token" or silently runs nothing).
+#
+# Verdicts come from the HTTP responses and the server log, NEVER from
+# Start-Process.ExitCode: under PS 5.1 with -NoNewWindow + redirection that
+# property can come back empty and misreport a pass as a failure (trap N30).
+#
+# Two log channels on purpose (trap N17): stdout carries the engine's own
+# self-report, stderr carries progress/errors; a single redirect loses one.
+# ============================================================================
+param(
+    [string]$Model          = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [int]$Port              = 18081,
+    [string]$Extra          = '--device-profile off',
+    [int]$ReadySec          = 900,
+    [int]$GenTimeoutSec     = 900,
+    [string]$Prompt         = 'Reply with exactly: KVMEM SM75 STACK OK',
+    [int]$MaxTokens         = 32,
+    [string]$Tag            = 'smoke_kvmem',
+    [string]$BuildDir       = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+$err = Join-Path $BuildDir "$Tag.server.err.log"
+$out = Join-Path $BuildDir "$Tag.server.out.log"
+
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+# Anchor the binary by hash and mtime: the "build <id>" string in the log comes
+# from a cmake stamp target that does NOT refresh on every rebuild.
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ("model      = {0}" -f $Model)
+
+Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+    ForEach-Object { Write-Output ('killing orphan: ' + $_.Name); Stop-Process -Id $_.Id -Force }
+Start-Sleep -Seconds 2
+
+# NB: not $args -- that is a PowerShell automatic variable.
+$argList = @($Model, '--host', '127.0.0.1', '--port', "$Port") +
+           @($Extra -split '\s+' | Where-Object { $_ -ne '' })
+Write-Output ("flags      = " + ($argList -join ' '))
+
+$proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+    -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $argList
+
+$base     = "http://127.0.0.1:$Port"
+$ready    = $false
+$deadline = (Get-Date).AddSeconds($ReadySec)
+while ((Get-Date) -lt $deadline) {
+    if ($proc.HasExited) { Write-Output "server exited before becoming ready"; break }
+    try {
+        $h = Invoke-RestMethod -Uri "$base/health" -TimeoutSec 3
+        $ready = $true
+        Write-Output ("health     = " + ($h | ConvertTo-Json -Compress))
+        break
+    } catch { Start-Sleep -Seconds 3 }
+}
+
+if (-not $ready) {
+    Write-Output 'RESULT: NOT-READY'
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 2
+    Write-Output '--- server stderr tail ---'
+    Get-Content -LiteralPath $err -Tail 40 -ErrorAction SilentlyContinue
+    exit 1
+}
+
+# The model id has to match the server's own alias or the request answers 404
+# model_not_found. Ask the server rather than guessing.
+$modelId = 'local'
+try {
+    $models = Invoke-RestMethod -Uri "$base/v1/models" -TimeoutSec 10
+    if ($models.data -and @($models.data).Count -gt 0) { $modelId = @($models.data)[0].id }
+    Write-Output ("model id   = " + $modelId)
+} catch {
+    Write-Output ("WARN: /v1/models failed: " + $_.Exception.Message)
+}
+try {
+    $load = Invoke-RestMethod -Uri "$base/v1/load" -TimeoutSec 10
+    Write-Output ("load       = " + ($load | ConvertTo-Json -Compress -Depth 6))
+} catch {
+    Write-Output ("WARN: /v1/load failed: " + $_.Exception.Message)
+}
+
+$body = @{
+    model      = $modelId
+    messages   = @(@{ role = 'user'; content = $Prompt })
+    max_tokens = $MaxTokens
+    stream     = $false
+} | ConvertTo-Json -Depth 5
+
+$sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $r = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+        -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeoutSec
+    $sw.Stop()
+    Write-Output ("generated  = {0:N1}s" -f $sw.Elapsed.TotalSeconds)
+    Write-Output ("answer     = " + $r.choices[0].message.content)
+    Write-Output ("usage      = " + ($r.usage | ConvertTo-Json -Compress))
+    Write-Output 'RESULT: OK'
+} catch {
+    $sw.Stop()
+    Write-Output ("REQUEST FAILED after {0:N1}s: {1}" -f $sw.Elapsed.TotalSeconds, $_.Exception.Message)
+    Write-Output 'RESULT: REQUEST-FAILED'
+}
+
+if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+Start-Sleep -Seconds 2
+Write-Output '--- server stderr tail (last 40) ---'
+Get-Content -LiteralPath $err -Tail 40 -ErrorAction SilentlyContinue
diff --git a/sm75_eval/run_ssd_tier.ps1 b/sm75_eval/run_ssd_tier.ps1
new file mode 100644
index 0000000..c8b2bc5
--- /dev/null
+++ b/sm75_eval/run_ssd_tier.ps1
@@ -0,0 +1,173 @@
+# ============================================================================
+# sm75 / KVMem 0.18 stack - SSD/RAM tiering acceptance ("force an eviction").
+#
+# WHY THIS EXISTS
+#   The previous round configured the disk tier and saw disk_writes = 0, because
+#   nothing ever pushed the Host payload budget over its limit. The tier only
+#   engages when the accumulated history exceeds --kvmem-host-mib, so the test
+#   must create that pressure deliberately.
+#
+#   Mechanism (program_impl.cpp:967-974):
+#     memory.disk_writes = memory_payload_storage.io_stats().writes
+#     memory.disk_payload_budget_bytes = kvmem_options.disk_bytes   (--kvmem-disk-mib)
+#   Both surface in GET /v1/load via kvmem_status_json.h, which is the verdict.
+#
+# HOW PRESSURE IS CREATED
+#   A BF16 KV page is 64 tokens and about 7.77 MiB on this model, i.e. roughly
+#   124 KiB per token. One 32K-token conversation therefore carries ~4 GiB of
+#   native KV, far more than a deliberately small --kvmem-host-mib, so the
+#   overflow must be written to the tier directory.
+#
+# WHAT IT COMPARES
+#   The same load against two tier locations, so the choice in the start script
+#   is made from a measurement rather than from the drive's label:
+#     E:\AI\KVMem_Ninfer_Speed\Cache   (the stack directory, on a 10 TB HDD)
+#     C:\Users\kevin\AppData\Local\Temp\disk_Cache   (Samsung 970 EVO NVMe)
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK).
+# Verdicts come from HTTP responses and log lines, never from ExitCode (N30).
+# ============================================================================
+param(
+    [string[]]$TierPaths = @(
+        'E:\AI\KVMem_Ninfer_Speed\Cache\kvmem_tier',
+        'C:\Users\kevin\AppData\Local\Temp\disk_Cache'
+    ),
+    [int]$Budget      = 12288,
+    [int]$Reserve     = 1536,
+    [int]$Ctx         = 262144,
+    [int]$HostMiB     = 1024,     # deliberately small: force the overflow
+    [int]$DiskMiB     = 8192,
+    [int]$Sessions    = 4,
+    [int]$Port        = 18092,
+    [int]$LongTokens  = 32768,
+    [int]$Requests    = 3,
+    [string]$Model    = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [int]$ReadySec    = 900,
+    [int]$GenTimeout  = 2400,
+    [string]$Tag      = 'ssdtier',
+    [string]$BuildDir = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model)) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("model      = {0}" -f $Model)
+Write-Output ("B={0} R={1} hostMiB={2} diskMiB={3} sessions={4} long={5} reqs={6}" -f $Budget, $Reserve, $HostMiB, $DiskMiB, $Sessions, $LongTokens, $Requests)
+Write-Output ("tier paths = {0}" -f ($TierPaths -join ' | '))
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 3
+}
+
+function Build-UniquePrompt {
+    param([int]$TargetTokens, [int]$Seed)
+    $base = 'Bounded KV windows stream the rest from host memory and spill to the tier when it fills. '
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($TargetTokens * 4)) {
+        [void]$sb.Append('s'); [void]$sb.Append($Seed); [void]$sb.Append('#'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    return $sb.ToString()
+}
+
+$rows = @()
+
+foreach ($tier in $TierPaths) {
+    Write-Output ('===== tier: ' + $tier + ' =====')
+    try { if (-not (Test-Path -LiteralPath $tier)) { New-Item -ItemType Directory -Path $tier -Force | Out-Null } }
+    catch { Write-Output ('  cannot create tier dir: ' + $_.Exception.Message); continue }
+
+    Stop-Orphans
+
+    $arm = '{0}_{1}' -f $Tag, (($tier -replace '[:\\]', '_') -replace '\s', '')
+    $err = Join-Path $BuildDir ("$arm.server.err.log")
+    $out = Join-Path $BuildDir ("$arm.server.out.log")
+    Remove-Item -LiteralPath $err, $out -ErrorAction SilentlyContinue
+
+    $argList = @($Model, '--host', '127.0.0.1', '--port', "$Port", '--device-profile', 'off',
+                 '--max-context', "$Ctx", '--max-concurrency', '1',
+                 '--kvmem-budget', "$Budget", '--kvmem-gen-reserve', "$Reserve",
+                 '--kvmem-host-mib', "$HostMiB", '--kvmem-sessions', "$Sessions",
+                 '--kvmem-disk-path', $tier, '--kvmem-disk-mib', "$DiskMiB",
+                 '--log-level', 'info')
+
+    $proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+        -RedirectStandardOutput $out -RedirectStandardError $err -ArgumentList $argList
+
+    $base     = "http://127.0.0.1:$Port"
+    $ready    = $false
+    $deadline = (Get-Date).AddSeconds($ReadySec)
+    while ((Get-Date) -lt $deadline) {
+        if ($proc.HasExited) { break }
+        try { [void](Invoke-RestMethod -Uri "$base/health" -TimeoutSec 3); $ready = $true; break }
+        catch { Start-Sleep -Seconds 5 }
+    }
+    if (-not $ready) {
+        Write-Output '  NOT-READY'
+        Get-Content -LiteralPath $err -ErrorAction SilentlyContinue | Select-Object -Last 8 | ForEach-Object { Write-Output ('    ' + $_) }
+        if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+        $rows += [pscustomobject]@{ tier = $tier; disk_writes = 'n/a'; written_MiB = 'n/a'; payload_MiB = 'n/a'; wall_s = 'n/a'; note = 'NOT-READY' }
+        continue
+    }
+
+    $modelId = 'local'
+    try {
+        $m = Invoke-RestMethod -Uri "$base/v1/models" -TimeoutSec 10
+        if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+    } catch { }
+
+    # Push the accumulated history past the Host budget.
+    $sw = [System.Diagnostics.Stopwatch]::StartNew()
+    for ($k = 1; $k -le $Requests; $k++) {
+        try {
+            $prompt = Build-UniquePrompt -TargetTokens $LongTokens -Seed $k
+            $body = @{ model = $modelId
+                       messages = @(@{ role = 'user'; content = $prompt })
+                       max_tokens = 8; stream = $false } | ConvertTo-Json -Depth 5
+            $r = Invoke-RestMethod -Uri "$base/v1/chat/completions" -Method Post `
+                 -ContentType 'application/json' -Body $body -TimeoutSec $GenTimeout
+            Write-Output ('  req {0}: prompt_tokens={1}' -f $k, $r.usage.prompt_tokens)
+        } catch { Write-Output ('  req {0} FAILED: {1}' -f $k, $_.Exception.Message) }
+    }
+    $sw.Stop()
+
+    $load = $null
+    try { $load = Invoke-RestMethod -Uri "$base/v1/load" -TimeoutSec 20 } catch { }
+
+    $dw = 'n/a'; $wb = 'n/a'; $pb = 'n/a'
+    if ($load) {
+        $j = $load | ConvertTo-Json -Depth 8
+        if ($j -match '"disk_writes"\s*:\s*(\d+)') { $dw = $Matches[1] }
+        if ($j -match '"disk_written_bytes"\s*:\s*(\d+)') { $wb = [math]::Round([double]$Matches[1] / 1MB, 1) }
+        if ($j -match '"disk_payload_bytes"\s*:\s*(\d+)') { $pb = [math]::Round([double]$Matches[1] / 1MB, 1) }
+        $kv = $load.kvmem
+        if ($kv) {
+            Write-Output ('  kvmem: enabled={0} selected={1} reserve={2} host_budget_MiB={3} disk_budget_MiB={4}' -f `
+                $kv.enabled, $kv.selected_tokens, $kv.reserve_tokens, `
+                [math]::Round([double]$kv.host_payload_budget_bytes / 1MB, 1), `
+                [math]::Round([double]$kv.disk_payload_budget_bytes / 1MB, 1))
+        }
+    }
+    Write-Output ("  verdict: disk_writes={0}  disk_written_MiB={1}  disk_payload_MiB={2}  wall={3:N1}s" -f $dw, $wb, $pb, $sw.Elapsed.TotalSeconds)
+
+    $rows += [pscustomobject]@{ tier = $tier; disk_writes = $dw; written_MiB = $wb; payload_MiB = $pb; wall_s = [math]::Round($sw.Elapsed.TotalSeconds, 1); note = '' }
+
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Start-Sleep -Seconds 3
+    Write-Output ''
+}
+
+Stop-Orphans
+Write-Output '================ SUMMARY ================'
+$rows | Format-Table -AutoSize | Out-String | Write-Output
+$csv = Join-Path $BuildDir ($Tag + '_summary.csv')
+Remove-Item -LiteralPath $csv -ErrorAction SilentlyContinue
+$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
diff --git a/sm75_eval/run_vision_kvmem.ps1 b/sm75_eval/run_vision_kvmem.ps1
new file mode 100644
index 0000000..78aa931
--- /dev/null
+++ b/sm75_eval/run_vision_kvmem.ps1
@@ -0,0 +1,258 @@
+﻿# ============================================================================
+# sm75 / KVMem 0.18 stack - vision POSITION acceptance with the user's three
+# images, each asked for ITS OWN ground truth.
+#
+# WHY THE FILLER MUST EXCEED THE DEVICE POOL
+#   The pool holds B+R tokens per lane. Any prompt shorter than that is fully
+#   resident, so an image it contains is never evicted and the probe proves only
+#   that full attention works - it says nothing about KVMem (the mistake the
+#   previous vision script made with a 32K filler against a 38400 pool). The
+#   filler here defaults ABOVE the pool, so the image's pages must be evicted and
+#   re-selected. kvmem_window.cpp:583 adds media pages to the MANDATORY set,
+#   which is exactly the mechanism these arms turn into evidence.
+#
+# GROUND TRUTH (user-specified, 2026-10-15)
+#   1.png  a green sticky note in the middle of a pile, carrying a black star
+#   2.png  the digit 8 somewhere in a landscape picture
+#   3.png  the password 7429 shown on a person
+#   An image PASSES only when every position returns its own ground truth; the
+#   run PASSES only when all three images pass at all four positions.
+#
+# WHY -KvDtype DEFAULTS TO rk8v4
+#   Measured on this card (2026-10-15): with bf16 KV the long profile's device
+#   reservation is 3.18 GiB against 2.75 GiB available after weights, so a 1M
+#   context with this pool cannot start at all; rk8v4 brings the same pool to
+#   1.50 GiB and leaves 1.09 GiB free. Vision residency needs that room.
+#
+# ASCII only (a PS 5.1 host reads a non-BOM .ps1 as ANSI/GBK: traps #20/#81).
+# Verdicts come from HTTP responses, never ExitCode (N30). The child argument
+# array is NOT named $args (that is a PowerShell automatic variable).
+# ============================================================================
+param(
+    [string]$Model = 'E:\AI\Models\HuggingFace\Ternary-Bonsai-2-27B-Heretic-ninfer.ninfer',
+    [string[]]$Images = @(
+        'E:\AI\Trae_Project\SOLO_记忆系统\临时工作区\临时测试题目\1.png',
+        'E:\AI\Trae_Project\SOLO_记忆系统\临时工作区\临时测试题目\2.png',
+        'E:\AI\Trae_Project\SOLO_记忆系统\临时工作区\临时测试题目\3.png'
+    ),
+    [string[]]$Labels = @('sticky-note', 'landscape-digit', 'person-code'),
+    [string[]]$Expect = @('star', '8', '7429'),
+    [string[]]$Positions = @('baseline', 'front', 'middle', 'back'),
+    [int]$FillerTokens = 51200,
+    [int]$Ctx = 1048576,
+    [string]$KvDtype = 'rk8v4',
+    [switch]$GdnFp16,
+    [string]$Mtp = 'off',
+    [int]$B = 32768,
+    [int]$R = 5632,
+    [int]$HostMib = 49152,
+    [string]$DiskPath = 'E:\AI\KVMem_Ninfer_Speed\Cache\kvmem',
+    [int]$DiskMiB = 102400,
+    [int]$Sessions = 1,
+    [int]$Sink = 4096,
+    [int]$Recent = 1024,
+    [int]$AskMax = 256,
+    [int]$BasePort = 18400,
+    [int]$ReadySec = 900,
+    [int]$GenTimeout = 3600,
+    [string]$Tag = 'visionpos',
+    [string]$BuildDir = 'E:\AI\ninfer-fusion\kvmem_build'
+)
+
+$ErrorActionPreference = 'Stop'
+
+if ($Images.Count -ne $Expect.Count -or $Images.Count -ne $Labels.Count) {
+    throw "Images / Labels / Expect must be the same length"
+}
+
+$exe = Join-Path $BuildDir 'apps\ninfer-serve.exe'
+foreach ($p in @($exe, $Model) + $Images) { if (-not (Test-Path -LiteralPath $p)) { throw "MISSING: $p" } }
+
+# One question per image, so a position-dependent failure shows up as that
+# image's own ground truth disappearing instead of a generic character count.
+$questions = @(
+    'Look at the image. In the middle of the pile of items there is a sticky note. Reply with exactly two lines. Line 1: NOTE-COLOR: <the colour of the note>. Line 2: NOTE-SHAPE: <the single shape drawn on it>.',
+    'Look at the landscape picture. A single digit appears in it. Reply with exactly that digit and nothing else.',
+    'Look at the image of the person. A 4-digit code is shown on it. Reply with exactly those four digits and nothing else.'
+)
+
+$b64s = @()
+foreach ($img in $Images) { $b64s += [Convert]::ToBase64String([System.IO.File]::ReadAllBytes($img)) }
+
+$pool = $B + $R
+Write-Output ("exe sha256 = {0}" -f (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash)
+Write-Output ("exe mtime  = {0}" -f (Get-Item -LiteralPath $exe).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))
+Write-Output ("images     = {0}" -f (($Labels | ForEach-Object { $_ }) -join ', '))
+Write-Output ("expect     = {0}" -f ($Expect -join ' | '))
+Write-Output ("kv-dtype   = {0}   mtp={1}   gdn-fp16={2}" -f $KvDtype, $Mtp, $GdnFp16)
+Write-Output ("pool       = B {0} + R {1} = {2} tokens/lane; filler {3} tokens ({4:N2}x pool)" -f `
+    $B, $R, $pool, $FillerTokens, ($FillerTokens / $pool))
+if ($FillerTokens -le $pool) {
+    Write-Output 'WARNING: filler <= pool, so every image stays resident and this run does NOT test eviction/re-selection.'
+}
+Write-Output ''
+
+function Stop-Orphans {
+    Get-Process -Name 'ninfer-serve', 'ninfer-perplexity', 'ninfer' -ErrorAction SilentlyContinue |
+        ForEach-Object { Stop-Process -Id $_.Id -Force }
+    Start-Sleep -Seconds 5
+}
+
+function Build-Filler {
+    param([int]$Tokens, [string]$Salt)
+    $base = 'The quick brown fox jumps over the lazy dog. A bounded KV window keeps part of the history on the device and streams the rest from the Host tier. '
+    $sb = [System.Text.StringBuilder]::new()
+    $i = 0
+    while ($sb.Length -lt ($Tokens * 4)) {
+        [void]$sb.Append('f'); [void]$sb.Append($Salt); [void]$sb.Append('#'); [void]$sb.Append($i)
+        [void]$sb.Append(' '); [void]$sb.Append($base)
+        $i++
+    }
+    return $sb.ToString()
+}
+
+# Places image i at the requested position inside the (optionally long) text.
+function Build-Content {
+    param([int]$Index, [string]$Where, [string]$Question, [string]$Filler)
+    $img = @{ type = 'image_url'; image_url = @{ url = "data:image/png;base64,$($b64s[$Index])" } }
+    if ($Where -eq 'baseline') { return @(@{ type = 'text'; text = $Question }, $img) }
+    if ($Where -eq 'front')    { return @($img, @{ type = 'text'; text = $Filler + ' ' + $Question }) }
+    if ($Where -eq 'back')     { return @(@{ type = 'text'; text = $Filler + ' ' + $Question }, $img) }
+    $half = [int]($Filler.Length / 2)
+    return @(@{ type = 'text'; text = $Filler.Substring(0, $half) }, $img,
+             @{ type = 'text'; text = $Filler.Substring($half) + ' ' + $Question })
+}
+
+function Get-DoneLines {
+    param([string]$LogPath)
+    return @(Get-Content -LiteralPath $LogPath -ErrorAction SilentlyContinue |
+             Select-String -Pattern 'req#\d+ done')
+}
+
+$arm = '{0}_{1}' -f $Tag, $KvDtype
+$errLog = Join-Path $BuildDir ("$arm.server.err.log")
+$outLog = Join-Path $BuildDir ("$arm.server.out.log")
+Remove-Item -LiteralPath $errLog, $outLog -ErrorAction SilentlyContinue
+Stop-Orphans
+
+$childArgs = @($Model, '--host', '127.0.0.1', '--port', "$BasePort", '--device-profile', 'off',
+               '--max-context', "$Ctx", '--max-concurrency', '1',
+               '--kvmem-budget', "$B", '--kvmem-gen-reserve', "$R",
+               '--kvmem-sink-tokens', "$Sink", '--kvmem-recent-tokens', "$Recent",
+               '--kvmem-host-mib', "$HostMib", '--kvmem-sessions', "$Sessions",
+               '--kvmem-disk-path', "$DiskPath", '--kvmem-disk-mib', "$DiskMiB",
+               '--vision', '--vision-residency', 'resident', '--log-level', 'info')
+if ($KvDtype -ne '') { $childArgs += @('--kv-dtype', $KvDtype) }
+if ($GdnFp16) { $childArgs += '--gdn-state-fp16' }
+if ($Mtp -eq 'mtp') { $childArgs += @('--spec', 'mtp', '--draft-tokens', '3') }
+Write-Output ('flags = ' + ($childArgs -join ' '))
+
+$t0 = Get-Date
+$proc = Start-Process -FilePath $exe -NoNewWindow -PassThru `
+    -RedirectStandardOutput $outLog -RedirectStandardError $errLog -ArgumentList $childArgs
+
+$baseUrl  = "http://127.0.0.1:$BasePort"
+$ready    = $false
+$deadline = (Get-Date).AddSeconds($ReadySec)
+while ((Get-Date) -lt $deadline) {
+    if ($proc.HasExited) { break }
+    try { [void](Invoke-RestMethod -Uri "$baseUrl/health" -TimeoutSec 3); $ready = $true; break }
+    catch { Start-Sleep -Seconds 5 }
+}
+$readySec = [math]::Round(((Get-Date) - $t0).TotalSeconds, 1)
+
+if (-not $ready) {
+    Write-Output ("NOT-READY after {0}s" -f $readySec)
+    Get-Content -LiteralPath $errLog -ErrorAction SilentlyContinue |
+        Select-String -Pattern 'KVMem rejected|vision|FATAL|requested Engine runtime reservation|it needs|can hold about' |
+        Select-Object -Last 6 | ForEach-Object { Write-Output ('  ' + $_.Line.Trim()) }
+    if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+    Write-Output 'RESULT: NOT-READY'
+    exit 1
+}
+
+Write-Output ("ready in {0}s" -f $readySec)
+$capText = @(Get-Content -LiteralPath $errLog -ErrorAction SilentlyContinue) |
+           Select-String -Pattern 'capacity \|' | Select-Object -Last 1
+if ($capText) { Write-Output ('  ' + $capText.Line.Trim()) }
+Write-Output ('  gpu = ' + ((& nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader) -join ' '))
+
+$modelId = 'local'
+try {
+    $m = Invoke-RestMethod -Uri "$baseUrl/v1/models" -TimeoutSec 10
+    if ($m.data -and @($m.data).Count -gt 0) { $modelId = @($m.data)[0].id }
+} catch { }
+$chatUrl = "$baseUrl/v1/chat/completions"
+
+$rows = @()
+for ($i = 0; $i -lt $Images.Count; $i++) {
+    foreach ($where in $Positions) {
+        $filler = if ($where -eq 'baseline') { '' } else { Build-Filler -Tokens $FillerTokens -Salt ('v' + $i + $where) }
+        $body = @{
+            model = $modelId
+            messages = @(@{ role = 'user'; content = (Build-Content -Index $i -Where $where -Question $questions[$i] -Filler $filler) })
+            max_tokens = $AskMax; stream = $false; temperature = 0.0
+        } | ConvertTo-Json -Depth 12
+
+        $answer = ''; $finish = 'n/a'; $wall = 0; $hit = 'MISS'; $note = ''
+        try {
+            $sw = [System.Diagnostics.Stopwatch]::StartNew()
+            # NOT $r: PowerShell variable names are case-insensitive, so $r IS the [int]
+            # parameter -R, and the response object would be cast to Int32 (measured
+            # 2026-10-16: the first vision run failed every arm that way).
+            $resp = Invoke-RestMethod -Uri $chatUrl -Method Post -ContentType 'application/json' `
+                    -Body $body -TimeoutSec $GenTimeout
+            $sw.Stop()
+            $wall = [math]::Round($sw.Elapsed.TotalSeconds, 1)
+            $message = $resp.choices[0].message
+            $answer = ([string]$message.content -replace "\s+", ' ').Trim()
+            $finish = [string]$resp.choices[0].finish_reason
+            # Chinese answers are common; match the ground truth in either script.
+            # "star" may come back in either script; the non-ASCII form is written as
+            # a \uXXXX regex escape so the judgement logic itself stays ASCII-only.
+            $pat = [regex]::Escape($Expect[$i])
+            if ($Expect[$i] -eq 'star') { $pat = 'star|\u661f' }
+            if ($answer -match $pat) { $hit = 'HIT' }
+        } catch {
+            $note = $_.Exception.Message
+            Write-Output ('  {0,-16} {1,-9} FAILED: {2}' -f $Labels[$i], $where, $note)
+        }
+        if ($hit -eq 'MISS' -and $answer.Length -gt 160) { $answer = $answer.Substring(0, 160) }
+        Write-Output ('  {0,-16} {1,-9} {2,-4} wall={3,7:N1}s finish={4,-8} answer=[{5}]' -f `
+            $Labels[$i], $where, $hit, $wall, $finish, $answer)
+        $rows += [pscustomobject]@{
+            image = $Labels[$i]; expect = $Expect[$i]; position = $where
+            hit = $hit; wall_s = $wall; finish = $finish; answer = $answer
+        }
+    }
+}
+
+$loadJson = 'n/a'
+try {
+    $load = Invoke-RestMethod -Uri "$baseUrl/v1/load" -TimeoutSec 30
+    $loadJson = ($load.kvmem | ConvertTo-Json -Compress)
+    Write-Output ('/v1/load kvmem = ' + $loadJson)
+} catch { }
+
+if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
+Start-Sleep -Seconds 3
+Stop-Orphans
+
+Write-Output '================ VISION POSITION SUMMARY ================'
+$rows | Format-Table image, position, hit, wall_s, finish -AutoSize | Out-String | Write-Output
+
+$misses = @($rows | Where-Object { $_.hit -ne 'HIT' })
+$csv = Join-Path $BuildDir ($arm + '_summary.csv')
+Remove-Item -LiteralPath $csv -ErrorAction SilentlyContinue
+$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
+Write-Output ('summary csv: ' + $csv)
+foreach ($img in $Labels) {
+    $mine = @($rows | Where-Object { $_.image -eq $img })
+    Write-Output ('  {0,-16} {1}/{2} positions returned the ground truth' -f $img,
+                  @($mine | Where-Object { $_.hit -eq 'HIT' }).Count, $mine.Count)
+}
+if ($misses.Count -eq 0) {
+    Write-Output 'RESULT: ALL-PASS (every image answered by its own ground truth at every position)'
+} else {
+    Write-Output ('RESULT: HAS-FAILURE ({0} of {1} arms missed)' -f $misses.Count, $rows.Count)
+}
